{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrandConfig",
  "description": "Schema for brand/brand.config.json — validated by apply-brand.mjs at load time.",
  "type": "object",
  "required": ["name", "domain", "tagline", "palette", "fonts", "studio"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Business display name."
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "description": "Production domain without protocol (e.g. example.com)."
    },
    "tagline": {
      "type": "string",
      "description": "One-line positioning statement."
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" }
      }
    },
    "palette": {
      "type": "object",
      "required": ["theme", "light", "dark"],
      "properties": {
        "theme": {
          "type": "object",
          "required": [
            "--color-primary",
            "--color-primary-dark",
            "--color-accent",
            "--color-accent-dark",
            "--color-secondary",
            "--color-tertiary",
            "--color-bg",
            "--color-bg-soft",
            "--color-border-soft",
            "--color-white-pure"
          ],
          "properties": {
            "--color-primary": { "$ref": "#/definitions/hex" },
            "--color-primary-dark": { "$ref": "#/definitions/hex" },
            "--color-accent": { "$ref": "#/definitions/hex" },
            "--color-accent-dark": { "$ref": "#/definitions/hex" },
            "--color-secondary": { "$ref": "#/definitions/hex" },
            "--color-tertiary": { "$ref": "#/definitions/hex" },
            "--color-bg": { "$ref": "#/definitions/hex" },
            "--color-bg-soft": { "$ref": "#/definitions/hex" },
            "--color-border-soft": { "$ref": "#/definitions/hex" },
            "--color-white-pure": { "$ref": "#/definitions/hex" }
          }
        },
        "light": {
          "type": "object",
          "required": [
            "--background",
            "--foreground",
            "--card",
            "--card-foreground",
            "--popover",
            "--popover-foreground",
            "--primary",
            "--primary-foreground",
            "--secondary",
            "--secondary-foreground",
            "--muted",
            "--muted-foreground",
            "--accent",
            "--accent-foreground",
            "--border",
            "--input",
            "--ring",
            "--link",
            "--tint-rgb"
          ],
          "properties": {
            "--background": { "$ref": "#/definitions/hex" },
            "--foreground": { "$ref": "#/definitions/hex" },
            "--card": { "$ref": "#/definitions/hex" },
            "--card-foreground": { "$ref": "#/definitions/hex" },
            "--popover": { "$ref": "#/definitions/hex" },
            "--popover-foreground": { "$ref": "#/definitions/hex" },
            "--primary": { "$ref": "#/definitions/hex" },
            "--primary-foreground": { "$ref": "#/definitions/hex" },
            "--secondary": { "$ref": "#/definitions/hex" },
            "--secondary-foreground": { "$ref": "#/definitions/hex" },
            "--muted": { "$ref": "#/definitions/hex" },
            "--muted-foreground": { "$ref": "#/definitions/hex" },
            "--accent": { "$ref": "#/definitions/hex" },
            "--accent-foreground": { "$ref": "#/definitions/hex" },
            "--border": { "$ref": "#/definitions/hex" },
            "--input": { "$ref": "#/definitions/hex" },
            "--ring": { "$ref": "#/definitions/hex" },
            "--link": { "$ref": "#/definitions/hex" },
            "--sidebar": { "$ref": "#/definitions/hex" },
            "--sidebar-foreground": { "$ref": "#/definitions/hex" },
            "--sidebar-primary": { "$ref": "#/definitions/hex" },
            "--sidebar-primary-foreground": { "$ref": "#/definitions/hex" },
            "--sidebar-accent": { "$ref": "#/definitions/hex" },
            "--sidebar-accent-foreground": { "$ref": "#/definitions/hex" },
            "--sidebar-border": { "$ref": "#/definitions/hex" },
            "--sidebar-ring": { "$ref": "#/definitions/hex" },
            "--tint-rgb": {
              "type": "string",
              "description": "Bare RGB triplet without rgb() wrapper (e.g. '88, 101, 119').",
              "pattern": "^\\d{1,3},\\s*\\d{1,3},\\s*\\d{1,3}$"
            },

            "--primary-accent": {
              "type": "string",
              "minLength": 1,
              "description": "Starwind: darker/lighter primary for hover states."
            },
            "--secondary-accent": {
              "type": "string",
              "minLength": 1,
              "description": "Starwind: dark/light active secondary."
            },
            "--info": {
              "type": "string",
              "minLength": 1,
              "description": "Starwind: informational surface color."
            },
            "--info-foreground": {
              "type": "string",
              "minLength": 1,
              "description": "Starwind: text on info surfaces."
            },
            "--success": {
              "type": "string",
              "minLength": 1,
              "description": "Starwind: success surface color."
            },
            "--success-foreground": {
              "type": "string",
              "minLength": 1,
              "description": "Starwind: text on success surfaces."
            },
            "--warning": {
              "type": "string",
              "minLength": 1,
              "description": "Starwind: warning surface color."
            },
            "--warning-foreground": {
              "type": "string",
              "minLength": 1,
              "description": "Starwind: text on warning surfaces."
            },
            "--error": {
              "type": "string",
              "minLength": 1,
              "description": "Starwind: error surface color (may use oklch)."
            },
            "--error-foreground": {
              "type": "string",
              "minLength": 1,
              "description": "Starwind: text on error surfaces."
            },
            "--outline": {
              "type": "string",
              "minLength": 1,
              "description": "Starwind: focus outline ring color."
            }
          }
        },
        "dark": {
          "type": "object",
          "required": ["--background", "--foreground", "--tint-rgb"],
          "description": "Dark mode semantic tokens. Most values are hex; --border, --input, --sidebar-border may use oklch() for alpha-composited values.",
          "properties": {
            "--background": { "type": "string", "minLength": 1 },
            "--foreground": { "type": "string", "minLength": 1 },
            "--tint-rgb": {
              "type": "string",
              "description": "Bare RGB triplet without rgb() wrapper (e.g. '138, 150, 166').",
              "pattern": "^\\d{1,3},\\s*\\d{1,3},\\s*\\d{1,3}$"
            }
          }
        }
      }
    },
    "fonts": {
      "type": "object",
      "required": ["display", "body", "script"],
      "properties": {
        "display": { "$ref": "#/definitions/fontEntry" },
        "body": { "$ref": "#/definitions/fontEntry" },
        "script": {
          "type": ["object", "null"],
          "description": "Script/calligraphic accent font. null = disabled (default).",
          "properties": {
            "familyValue": { "type": "string", "minLength": 1 },
            "imports": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "radius": {
      "type": "string",
      "description": "Border-radius personality token (e.g. '0.5rem', '0.25rem', '1rem'). Drives --radius in globals.css.",
      "pattern": "^[0-9]+(\\.[0-9]+)?(rem|px|em)$"
    },
    "layout": {
      "type": "object",
      "description": "Structure variants (the second axis beside palette and fonts). Each slot's FIRST value is the original layout. See src/lib/site-layout.ts.",
      "properties": {
        "header": { "type": "string", "enum": ["inline", "centered", "minimal"] },
        "hero": { "type": "string", "enum": ["bleed", "split", "editorial", "board"] },
        "density": { "type": "string", "enum": ["standard", "airy", "tight"] },
        "cards": { "type": "string", "enum": ["standard", "outline", "soft"] }
      }
    },
    "workerName": {
      "type": ["string", "null"],
      "description": "Cloudflare Worker name. When set (non-null) and domain != example.com, apply-brand rewrites the 'name' field in wrangler.jsonc. null = leave wrangler.jsonc untouched."
    },
    "logoPaths": {
      "type": "object",
      "properties": {
        "light": { "type": "string" },
        "dark": { "type": "string" }
      }
    },
    "studio": {
      "type": "object",
      "required": ["fonts"],
      "properties": {
        "fonts": {
          "type": "object",
          "required": ["display", "body"],
          "description": "Font stacks for the Sanity Studio theme, written into DISPLAY_STACK / BODY_STACK in the repo-root sanity.config.ts. Use double quotes around family names: the target is a single-quoted TS literal, so a single quote is rejected.",
          "properties": {
            "display": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 }
          }
        },
        "accent": {
          "$ref": "#/definitions/hex",
          "description": "Optional. The Studio's accent (primary buttons, links, focus rings) when the site's palette.light --primary is wrong for UI chrome. Only its hue and saturation are used; src/lib/studio-theme.ts solves the lightness and guards contrast (PORTS.md card 110)."
        },
        "look": {
          "type": "object",
          "description": "Optional. The site's own devices inside the Studio (PORTS.md card 128, src/lib/studio-look.ts): every family site should differ in form, not only color. Unset keys take neutral defaults (a dot marker, round stones, a plain line, no texture, no lettering). Colors are guarded for contrast; an unusable value is ignored with a note.",
          "properties": {
            "marker": {
              "description": "The section marker: \"dot\", \"steps\", \"rule\" or \"diamond\", or the site's own art { src (a path in public/), width, height }.",
              "oneOf": [
                { "type": "string", "enum": ["dot", "steps", "rule", "diamond"] },
                {
                  "type": "object",
                  "required": ["src", "width", "height"],
                  "properties": {
                    "src": { "type": "string" },
                    "width": { "type": "number" },
                    "height": { "type": "number" }
                  }
                }
              ]
            },
            "markerColor": { "$ref": "#/definitions/hex" },
            "headingColor": { "$ref": "#/definitions/hex" },
            "markColors": {
              "type": "array",
              "description": "The numbered stones' colors, in order.",
              "items": { "$ref": "#/definitions/hex" }
            },
            "stone": {
              "type": "string",
              "enum": ["pebble", "round", "square", "lozenge", "brick"]
            },
            "stoneFlecks": {
              "type": "string",
              "description": "Card 180: a print texture over every filled stone, an SVG path in public/."
            },
            "connector": {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "enum": ["dashes", "dots", "line", "none"] },
                "color": { "$ref": "#/definitions/hex" }
              }
            },
            "tones": {
              "type": "object",
              "description": "The callout hues: note, tip, careful.",
              "properties": {
                "note": { "$ref": "#/definitions/hex" },
                "tip": { "$ref": "#/definitions/hex" },
                "careful": { "$ref": "#/definitions/hex" }
              }
            },
            "motif": {
              "type": "string",
              "description": "A wide, short SVG in public/ for a banner's foot."
            },
            "motifNarrow": { "type": "string" },
            "texture": {
              "type": "string",
              "description": "A repeating tile SVG in public/ for featured panels."
            },
            "edgeColors": { "type": "array", "items": { "$ref": "#/definitions/hex" } },
            "lettering": {
              "type": "object",
              "required": ["family", "src"],
              "properties": {
                "family": { "type": "string" },
                "src": { "type": "string" },
                "colors": { "type": "array", "items": { "$ref": "#/definitions/hex" } }
              }
            },
            "motion": { "type": "string", "enum": ["lay", "draw", "none"] },
            "splash": {
              "type": "string",
              "enum": ["path", "motif"],
              "description": "What the /studio loading splash and offline page show under the name: the stone path (default) or the site's own art from src/sanity/StudioSplashMotif.astro in its place (PORTS.md card 162)."
            }
          }
        },
        "icons": {
          "type": "object",
          "description": "Optional. The Studio's icons by meaning (PORTS.md card 119, src/lib/studio-icons.ts lists the meanings). The art for a meaning is src/sanity/brandIconArt.tsx; these maps say which document type, field group or tool means what, on top of the starter's defaults.",
          "properties": {
            "types": {
              "type": "object",
              "description": "Document type name -> meaning, e.g. \"sermon\": \"scripture\".",
              "additionalProperties": { "type": "string" }
            },
            "groups": {
              "type": "object",
              "description": "Field group name -> meaning, e.g. \"media\": \"image\".",
              "additionalProperties": { "type": "string" }
            },
            "tools": {
              "type": "object",
              "description": "Tool name -> meaning, e.g. \"home\": \"home\".",
              "additionalProperties": { "type": "string" }
            },
            "tile": {
              "type": "object",
              "description": "The square behind a type's icon in a list row when the document has no image of its own. Unset: a wash of the accent on the paper (light) and on the dark ground (dark).",
              "properties": {
                "light": { "$ref": "#/definitions/hex" },
                "dark": { "$ref": "#/definitions/hex" }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "hex": {
      "type": "string",
      "description": "6-digit hex color with leading #.",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "fontEntry": {
      "type": "object",
      "required": ["familyValue", "imports"],
      "properties": {
        "familyValue": {
          "type": "string",
          "minLength": 1,
          "description": "CSS font-family value for use in a stylesheet."
        },
        "ogFontStack": {
          "type": "string",
          "description": "Font stack string for the OG image generator (node-canvas)."
        },
        "imports": {
          "type": "array",
          "items": { "type": "string" },
          "description": "@fontsource import paths to write into globals.css."
        }
      }
    }
  }
}
