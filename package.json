{
  "name": "ncs-astro-sanity-starter",
  "type": "module",
  "version": "0.0.1",
  "license": "PolyForm-Strict-1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/with-workerd.mjs astro build && node scripts/purge-page-css.mjs && node scripts/build-csp.mjs && node scripts/build-search-index.mjs",
    "build:full": "npm run typegen && npm run build",
    "preview": "wrangler dev -c dist/server/wrangler.json",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "generate-types": "wrangler types",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "og": "node scripts/generate-og-default.mjs",
    "contact:migration": "node --experimental-strip-types scripts/gen-contact-migration.mjs",
    "og:pages": "node scripts/generate-og-pages.mjs",
    "apply-brand": "node scripts/apply-brand.mjs",
    "llms:full": "node scripts/generate-llms-full.mjs",
    "studio:import": "node scripts/import-content.mjs",
    "seed": "node scripts/seed-core.mjs",
    "parity": "node scripts/page-parity.mjs",
    "cutover": "node scripts/cutover.mjs",
    "sync-check": "node scripts/sync-check.mjs",
    "check:look": "node --experimental-strip-types scripts/check-studio-look.mjs",
    "ports:next": "node scripts/next-port-card.mjs",
    "restore:doc": "node scripts/restore-doc.mjs",
    "deadweight": "node scripts/find-dead-weight.mjs",
    "references": "node scripts/capture-references.mjs",
    "directions:shoot": "node scripts/screenshot-directions.mjs",
    "free-dist": "node scripts/free-dist.mjs",
    "check": "astro check && npm run lint",
    "check:full": "npm run typegen && npm run build && npm run test:unit",
    "lint": "eslint src/**/*.{ts,tsx,astro} scripts/**/*.mjs",
    "lint:fix": "eslint --fix src/**/*.{ts,tsx,astro} scripts/**/*.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --experimental-strip-types --test src/lib/*.test.ts && npm run test:scripts",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "thumbnails": "node scripts/shoot-section-thumbnails.mjs",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots=all",
    "links:live": "node scripts/check-live-links.mjs",
    "serve:dist": "node scripts/serve-dist.mjs --port 4321",
    "check:links": "linkinator ./dist/client --recurse --skip \"^https?://(?!(localhost|127[.]0[.]0[.]1)[:/])\" --skip \"/studio\" --skip \"/preview\" --skip \"/api/\"",
    "favicon": "node scripts/generate-favicons.mjs",
    "scaffold": "node scripts/scaffold.mjs",
    "audit:studio": "node scripts/audit-studio.mjs",
    "audit:data": "node scripts/audit-data-vs-schema.mjs",
    "search:index": "node scripts/build-search-index.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.0",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/libre-baskerville": "^5.2.0",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/astro": "3.5.1",
    "@sanity/client": "8.9.0",
    "@sanity/icons": "5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "2.0.28",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/themer": "0.10.4",
    "@sanity/ui": "4.4.9",
    "@sanity/vision": "6.19.0",
    "@sanity/visual-editing": "6.1.3",
    "@tabler/icons": "^3.49.0",
    "@tabler/icons-react": "^3.49.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next-themes": "^0.4.6",
    "primereact": "^10.9.8",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-photo-album": "^3.6.2",
    "sanity": "6.19.0",
    "sanity-plugin-asset-source-unsplash": "7.0.29",
    "sanity-plugin-media": "6.3.5",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "styled-components": "6.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "wrangler": "~4.129.0",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "overrides": {
    "sanity-plugin-utils": "2.0.22",
    "@sanity/visual-editing": "6.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "groq-js": "2.0.0",
    "http-server": "^14.1.1",
    "linkinator": "^8.1.0",
    "mammoth": "1.13.0",
    "opentype.js": "^2.0.0",
    "pagefind": "1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "unpdf": "1.9.1"
  }
}
