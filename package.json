{
  "name": "ncs-astro-sanity-starter",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/with-workerd.mjs astro build",
    "build:full": "npm run typegen && npm run build",
    "preview": "wrangler dev -c dist/server/wrangler.json",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "generate-types": "wrangler types",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "og": "node scripts/generate-og-default.mjs",
    "og:pages": "node scripts/generate-og-pages.mjs",
    "apply-brand": "node scripts/apply-brand.mjs",
    "llms:full": "node scripts/generate-llms-full.mjs",
    "studio:import": "node scripts/import-content.mjs",
    "seed": "node scripts/seed-core.mjs",
    "parity": "node scripts/page-parity.mjs",
    "sync-check": "node scripts/sync-check.mjs",
    "free-dist": "node scripts/free-dist.mjs",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "check": "npm run typegen && npm run build && npm test",
    "lint": "eslint src/**/*.{ts,tsx,astro} scripts/**/*.mjs",
    "lint:fix": "eslint --fix src/**/*.{ts,tsx,astro} scripts/**/*.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/libre-baskerville": "^5.2.0",
    "@portabletext/react": "^6.2.0",
    "@portabletext/types": "^4.0.2",
    "@sanity/astro": "3.4.2",
    "@sanity/client": "7.23.0",
    "@sanity/icons": "3.8.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "2.0.9",
    "@sanity/preview-url-secret": "4.0.8",
    "@sanity/ui": "3.3.5",
    "@sanity/vision": "6.4.0",
    "@sanity/visual-editing": "5.4.5",
    "@tabler/icons": "^3.44.0",
    "@tabler/icons-react": "^3.44.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "primereact": "^10.9.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-is": "19.2.7",
    "react-photo-album": "^3.6.0",
    "sanity": "6.4.0",
    "sanity-plugin-asset-source-unsplash": "7.0.15",
    "sanity-plugin-media": "5.0.11",
    "shadcn": "^4.8.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "styled-components": "6.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "wrangler": "~4.110.0",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "overrides": {
    "sanity-plugin-utils": "2.0.6",
    "@sanity/visual-editing": "5.4.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.7.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript-eslint": "^8.61.0"
  }
}
