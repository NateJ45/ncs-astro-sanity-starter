---
// Safe to edit by hand
// Privacy policy page. Fetches the privacyPage singleton from Sanity for the
// body and lastUpdated date. When the doc doesn't exist yet (or Sanity isn't
// reachable), a plain-voice fallback policy is rendered so the page is always
// live and accurate.
//
// A page builder since card 190 (ported from FBC Auburn): when the document's Page layout has
// sections, they render through SectionRenderer, and the policy is the "Privacy policy text"
// block (src/components/sections/PrivacyPolicy.astro, which also holds the built-in fallback
// copy and the analytics-aware wording). With an EMPTY Page layout the page draws exactly what it
// always did: the hero fields, then that same block fed by the document's own body and date.
// scripts/main-pages-builder.mjs seeds the Page layout when the editor should be able to
// rearrange the page.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import Hero from '@/components/Hero.astro';
import PrivacyPolicy from '@/components/sections/PrivacyPolicy.astro';
import { getPrivacyPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

const [page, siteSettings] = await Promise.all([getPrivacyPage(), getSiteSettings()]);

const title = page?.seoTitle ?? `Privacy Policy · ${site.name}`;
const description =
  page?.seoDescription ??
  'How we handle the information you share when you reach out or subscribe.';

const heroEyebrow = page?.heroEyebrow ?? 'Transparency first.';
const heroHeadline = page?.heroHeadline ?? 'Privacy Policy';
const heroSubhead = page?.heroSubhead ?? '';

// The Page layout, when the editor has built one. Empty means the classic layout below.
const sections = page?.pageBuilder?.length ? page.pageBuilder : null;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Privacy Policy', url: `${site.url}/privacy/` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  {sections ? (
    <SectionRenderer {sections} idPrefix="privacy" />
  ) : (
    <>
      {/* Hero: text variant, short height. */}
      <Hero
        eyebrow={heroEyebrow}
        headline={heroHeadline}
        subhead={heroSubhead}
        headingId="privacy-hero-heading"
        size="short"
      />

      <PrivacyPolicy lastUpdated={page?.lastUpdated} body={page?.body} />
    </>
  )}
</BaseLayout>
