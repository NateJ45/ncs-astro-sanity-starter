---
// PORTABLE: canonical copy - ncs-astro-sanity-starter is the library of record for this file
// Foundation, edit with care
// =============================================================================
// /studio/offline/: what the Studio app shows with no connection (card 124)
// =============================================================================
// The Studio's service worker (public/studio/sw.js) keeps a copy of this page
// and shows it when the editor opens the app with no signal, instead of the
// phone's own "no internet" screen. Plain HTML and CSS, no script but the
// "Try again" button and the colour-scheme pick, the Studio's own colours. The
// words are the brief's: a change made before the signal went is still waiting
// in the open Studio and goes through when the connection is back; nothing
// here can lose it.
// =============================================================================
import brand from '../../../brand/brand.config.json';
import { STUDIO_COLORS } from '../../sanity/studioTheme';

export const prerender = true;

const name = brand.name;
const vars = [
  `--paper: ${STUDIO_COLORS.white}`,
  `--dark: ${STUDIO_COLORS.black}`,
  `--chrome: ${STUDIO_COLORS.chrome.bg}`,
  `--muted-light: ${STUDIO_COLORS.gray['600']}`,
  `--ink-dark: ${STUDIO_COLORS.gray['50']}`,
  `--muted-dark: ${STUDIO_COLORS.gray['400']}`,
].join('; ');
---

<!doctype html>
<html lang="en" style={vars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{`You're offline | ${name}`}</title>
    <meta name="theme-color" content={STUDIO_COLORS.chrome.bg} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        var pick = localStorage.getItem('sanityStudio:ui:colorScheme');
        if (pick === 'dark' || pick === 'light') {
          document.documentElement.setAttribute('data-studio-scheme', pick);
        }
      } catch (_e) {
        /* Storage blocked: the media query decides. */
      }
    </script>
    <style is:global>
      html,
      body {
        margin: 0;
        background: var(--paper);
        color: var(--chrome);
        font-family: system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      @media (prefers-color-scheme: dark) {
        html:not([data-studio-scheme='light']),
        html:not([data-studio-scheme='light']) body {
          background: var(--dark);
          color: var(--ink-dark);
        }
        html:not([data-studio-scheme='light']) .note {
          color: var(--muted-dark);
        }
      }
      html[data-studio-scheme='dark'],
      html[data-studio-scheme='dark'] body {
        background: var(--dark);
        color: var(--ink-dark);
      }
      html[data-studio-scheme='dark'] .note {
        color: var(--muted-dark);
      }
      main {
        box-sizing: border-box;
        min-height: 100vh;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 24px 16px;
      }
      .inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        max-width: 26rem;
        text-align: center;
      }
      img {
        width: 56px;
        height: 56px;
      }
      h1 {
        margin: 0;
        font-size: 1.375rem;
        line-height: 1.25;
        font-weight: 600;
      }
      .note {
        margin: 0;
        font-size: 1rem;
        line-height: 1.5;
        color: var(--muted-light);
      }
      button {
        margin-top: 8px;
        min-height: 48px;
        padding: 0 24px;
        border: 0;
        border-radius: 6px;
        background: var(--chrome);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button:focus-visible {
        outline: 3px solid currentColor;
        outline-offset: 3px;
      }
      html[data-studio-scheme='dark'] button {
        outline-color: var(--ink-dark);
      }
    </style>
  </head>
  <body>
    <main>
      <div class="inner" data-studio-offline>
        <img src="/favicon.svg" alt="" width="56" height="56" />
        <h1>You're offline</h1>
        <p class="note">
          Your changes are saved when you're back online. Check your Wi-Fi or signal, then try
          again.
        </p>
        <button type="button" onclick="location.href='/studio/'">
          Try again
        </button>
      </div>
    </main>
  </body>
</html>
