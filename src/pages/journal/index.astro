---
// scaffold-file: journal
// Safe to edit by hand for copy + structure changes.
// Journal index page. A page builder since card 190 (ported from FBC Auburn): when the
// document's Page layout has sections, they render through SectionRenderer, and the posts are
// the "Journal posts" block (src/components/sections/JournalPosts.astro: category chips, the post
// grid and the newsletter sign-up). With an EMPTY Page layout the page draws exactly what it
// always did: hero, that same block, then the final CTA, all from the document's own fields.
// scripts/main-pages-builder.mjs seeds the Page layout when the editor should be able to
// rearrange the page. Sanity-driven via getJournalPage() plus the block's own reads of the
// posts and categories.
//
// First post gets the `featured` card treatment (spans 2 columns at lg, larger
// type). If editors flag multiple posts as featured, the first by date wins
// the big slot; others get normal cards.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getJournalPage, getSiteSettings } from '@/lib/queries';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';

import Hero from '@/components/Hero.astro';
import JournalPosts from '@/components/sections/JournalPosts.astro';
import FinalCta from '@/components/FinalCta.astro';

const [page, siteSettings] = await Promise.all([getJournalPage(), getSiteSettings()]);

// Section visibility guard.
const visible = getSectionVisibility(siteSettings?.sectionVisibility);
if (!visible.journal) return Astro.redirect('/');

const title = page?.seoTitle ?? 'Journal · Studio Starter';
const description =
  page?.seoDescription ??
  'Notes from the studio — project walkthroughs, style thinking, and the occasional opinion.';

const heroEyebrow = page?.heroEyebrow ?? 'The Journal.';
const heroHeadline = page?.heroHeadline ?? 'Notes from the studio.';
const heroSubhead =
  page?.heroSubhead ??
  'Project walkthroughs, design thinking, and the occasional opinion. Written between projects.';

// The Page layout, when the editor has built one. Empty means the classic layout below.
const sections = page?.pageBuilder?.length ? page.pageBuilder : null;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Journal', url: `${site.url}/journal/` },
  ]),
];
---

<BaseLayout
  {title}
  {description}
  {schemas}
  {siteSettings}
  seoImage={page?.seoImage}
  ogCard={{ kicker: heroEyebrow }}
>
  {sections ? (
    <SectionRenderer {sections} idPrefix="journal" />
  ) : (
    <>
      {/* ------- 1. Hero ------------------------------------------------------- */}
      <Hero
        eyebrow={heroEyebrow}
        headline={heroHeadline}
        subhead={heroSubhead}
        backgroundImage={page?.heroImage}
        headingId="journal-hero-heading"
        size="short"
        scriptAccent={page?.heroScriptAccent ?? 'studio'}
      />

      {/* ------- 2. Category chips, post grid and newsletter signup ------------ */}
      <JournalPosts headingId="journal-posts-heading" />

      {/* ------- 3. Final CTA -------------------------------------------------- */}
      <FinalCta
        headline={page?.finalCtaHeadline}
        subhead={page?.finalCtaSubhead}
        cta={page?.finalCta}
        scriptAccent={page?.finalCtaScriptAccent}
        backgroundImage={page?.finalCtaBackgroundImage}
      />
    </>
  )}
</BaseLayout>
