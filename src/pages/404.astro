---
import { withTrailingSlash } from '@/lib/href';
// Safe to edit by hand
// Custom 404. Warm, on-brand, clear paths back.
//
// With site search on (site.search.enabled, card 126), a search box comes
// first: a plain GET form to /search/?q=..., so it works without JavaScript.
// Under it, always, the site's suggested pages (site.search.suggestions), so a
// site with search off still offers somewhere useful to go (card 158).
//
// Layout: two-column on desktop (text + photograph), stacked on mobile. The
// photo is sourced from Sanity and can be replaced with any studio photo.
// Asset is referenced by _ref so it pipes through the same SanityImage
// CDN/transform pipeline as every other photo on the site.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNotFoundPage, getSiteSettings } from '@/lib/queries';
import SanityImage from '@/components/SanityImage.astro';
import { site } from '@/data/site';

const [notFoundPage, siteSettings] = await Promise.all([getNotFoundPage(), getSiteSettings()]);

// Fallback photo — Studio dogs on the sofa, in case the singleton hasn't been
// populated. Sanity singleton always wins if its image field is set.
const fallbackPhoto = {
  asset: { _ref: 'image-ce9be41407b946b7453724575c3cfd7aec2f7c4c-3024x4032-jpg' },
  alt: 'Studio photo.',
};

const seoTitle = notFoundPage?.seoTitle ?? 'Page not found';
const seoDescription =
  notFoundPage?.seoDescription ??
  'That page wandered off. Head back to the homepage or get in touch.';

const eyebrow = notFoundPage?.eyebrow ?? '404';
const headline = notFoundPage?.headline ?? 'That page wandered off.';
const body =
  notFoundPage?.body ??
  "It happens. Maybe a link is old, maybe the URL has a typo. Either way, here's where to head next.";

const primaryLabel = notFoundPage?.primaryCtaLabel ?? 'Back home';
const primaryHref = withTrailingSlash(notFoundPage?.primaryCtaHref) ?? '/';
// A CORE route, not /portfolio: the portfolio is an opt-in module that a fresh
// clone does not build, so the old default shipped a 404 page whose own button
// 404s. A project that turns the module on can point this at /portfolio in the
// Studio.
const secondaryLabel = notFoundPage?.secondaryCtaLabel ?? 'Back to the home page';
const secondaryHref = withTrailingSlash(notFoundPage?.secondaryCtaHref) ?? '/';
const tertiaryLabel = notFoundPage?.tertiaryCtaLabel ?? 'Get in touch';
const tertiaryHref = withTrailingSlash(notFoundPage?.tertiaryCtaHref) ?? '/contact/';

// Hand-written in src/data/site.ts, so they already end in a slash (rule 19).
const suggestions = site.search.suggestions ?? [];

const photo = notFoundPage?.heroImage ?? fallbackPhoto;
const caption = notFoundPage?.heroImage?.caption ?? 'From the studio';
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  siteSettings={siteSettings}
  noindex
  flow="full"
>
  {/* THE SHARED SPLIT (PORTS.md card 91). Words first, photo on the narrow track; it was
      1fr / 1.1fr at `md`, so its seam sat left of every other band's. The photo stays
      first in the DOM for the stacked phone order and `lg:order-2` puts it on the right. */}
  <section
    class="split mx-auto max-w-content items-center px-m py-section-lg"
    aria-labelledby="not-found-heading"
  >
    {/* Text column. Search (when the site has it), suggested pages, then the
        buttons back.
        Centered on mobile so the lone-element page reads as a sympathetic
        "you're off-path" moment; left-aligned on desktop where the
        two-column layout needs the text anchored beside the photo column. */}
    <div class="text-center lg:text-left">
      <p class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">{eyebrow}</p>
      <h1
        id="not-found-heading"
        class="font-display text-h1 leading-headline-tight text-foreground"
      >
        {headline}
      </h1>
      <p class="mx-auto mt-m max-w-xl text-lg leading-relaxed text-foreground/80 lg:mx-0">{body}</p>

      {site.search.enabled && (
        <form
          class="mx-auto mt-l max-w-xl text-left lg:mx-0"
          role="search"
          action="/search/"
          method="get"
        >
          <label for="not-found-search" class="mb-xs block text-sm font-semibold text-foreground">
            Search the site
          </label>
          <div class="flex gap-s">
            <input
              id="not-found-search"
              class="min-h-[44px] min-w-0 flex-1 rounded-sm border border-border-soft bg-background px-m text-base text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
              type="search"
              name="q"
              autocomplete="off"
              enterkeyhint="search"
              placeholder={site.search.placeholder}
            />
            <button
              type="submit"
              class="press-tactile inline-flex min-h-[44px] items-center rounded-sm border border-primary px-m text-xs font-semibold tracking-eyebrow text-link uppercase hover:bg-accent"
            >
              Search
            </button>
          </div>
        </form>
      )}

      {suggestions.length > 0 && (
        <nav
          class="mx-auto mt-l max-w-xl text-center lg:mx-0 lg:text-left"
          aria-labelledby="not-found-suggestions"
        >
          <p id="not-found-suggestions" class="mb-xs text-sm font-semibold text-foreground">
            Pages people often look for
          </p>
          <ul class="flex flex-wrap justify-center gap-x-m gap-y-xs lg:justify-start" role="list">
            {suggestions.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="inline-flex min-h-[44px] items-center text-link underline underline-offset-4 hover:text-primary-dark"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="mt-l flex flex-wrap justify-center gap-m lg:justify-start">
        <a
          href={primaryHref}
          class="press-tactile inline-flex items-center rounded-sm bg-primary-dark px-l py-s text-xs font-semibold tracking-eyebrow text-white uppercase hover:bg-accent-dark"
        >
          {primaryLabel}
        </a>
        <a
          href={secondaryHref}
          class="press-tactile inline-flex items-center rounded-sm border border-primary px-l py-s text-xs font-semibold tracking-eyebrow text-link uppercase hover:bg-accent"
        >
          {secondaryLabel}
        </a>
        <a
          href={tertiaryHref}
          class="press-tactile inline-flex items-center rounded-sm border border-border-soft px-l py-s text-xs font-semibold tracking-eyebrow text-foreground/85 uppercase hover:border-primary hover:text-primary-dark"
        >
          {tertiaryLabel}
        </a>
      </div>
    </div>

    {/* Photo column. Stacks above the text on mobile (lg:order-2 swaps it on
        desktop so the eye lands on text first, photo balances right). */}
    <figure class="order-first lg:order-2">
      <SanityImage
        source={photo}
        width={1200}
        sizes="(min-width: 1024px) 45vw, 100vw"
        quality={75}
        class="h-auto w-full rounded-md"
      />
      <figcaption class="mt-s text-right text-xs tracking-eyebrow text-foreground/80 uppercase">
        {caption}
      </figcaption>
    </figure>
  </section>
</BaseLayout>
