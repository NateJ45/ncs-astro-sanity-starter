---
// Foundation, edit with care
//
// THE LAYOUT WALL: the fixed-data page tests/visual/layouts.spec.ts shoots, one
// region per layout slot (PORTS.md card 72). /styleguide covers the design
// system at the site's configured layout; this page exists so every VARIANT of
// every slot can be shot from one build.
//
//   - hero: one <Hero> per variant, each given an explicit `variant`. The board
//     head (card 188) sits at the END of the page, after the split bands: a shot
//     region placed earlier would move the existing baselines by a pixel.
//   - cards, density, header: the spec flips the matching data-* attribute on
//     <html>, the same attributes BaseLayout emits from brand.config.json, so the
//     CSS under test is the CSS a configured site ships.
//
// Fixed data on purpose (see styleguide.astro for why). The hero image is a fake
// Sanity asset reference; the spec answers the CDN request with a local fixture
// so no network is needed. noindex, filtered from the sitemap (astro.config.mjs
// matches '/styleguide'), and 'styleguide' is a reserved slug.

import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro'; // scaffold: testimonials
import JournalCard from '@/components/JournalCard.astro'; // scaffold: journal
import SectionHeading from '@/components/SectionHeading.astro';
import ImageText from '@/components/sections/ImageText.astro';
import ServiceAreaSection from '@/components/sections/ServiceAreaSection.astro';
import { site } from '@/data/site';

const image = {
  _type: 'image',
  alt: 'Fixture image',
  asset: {
    _type: 'reference',
    _ref: 'image-0123456789abcdef0123456789abcdef01234567-1600x900-jpg',
  },
};

const hero = {
  eyebrow: 'Layout fixture',
  headline: 'A heading long enough to wrap across two lines',
  subhead: 'One supporting sentence so the hero has body copy to carry.',
  primaryCta: { label: 'Primary action', linkType: 'external', externalUrl: '/' },
  secondaryCta: { label: 'Secondary', linkType: 'external', externalUrl: '/' },
} as const;

// Portable Text for the image-and-text bands: one plain paragraph.
const body = [
  {
    _type: 'block',
    _key: 'fx-body',
    style: 'normal',
    markDefs: [],
    children: [
      {
        _type: 'span',
        _key: 'fx-span',
        marks: [],
        text: 'One paragraph of fixed copy so the text column has something to wrap.',
      },
    ],
  },
];

const service = {
  name: 'Fixture service',
  price: 'From $100',
  shortDescription: 'A short description of what this service is.',
  features: ['First feature', 'Second feature', 'Third feature'],
  ctaLabel: 'Learn more',
};
// scaffold: testimonials
const testimonial = {
  quote: 'A fixed quotation so the card has a body to wrap.',
  attribution: 'A Client',
  date: '2026-01-15',
};
// scaffold:end
// scaffold: journal
const entry = {
  title: 'A fixed journal entry title',
  slug: { current: 'fixture' },
  excerpt: 'A fixed excerpt for the journal card.',
  publishedAt: '2026-01-15',
};
// scaffold:end
---

<BaseLayout
  title={`Layout wall | ${site.name}`}
  description="Fixed-data layout variants wall. Not for visitors."
  noindex
>
  <div data-fx="hero-bleed">
    <Hero {...hero} backgroundImage={image} headingId="fx-h-bleed" variant="bleed" />
  </div>
  <div data-fx="hero-split">
    <Hero {...hero} backgroundImage={image} headingId="fx-h-split" variant="split" />
  </div>
  <div data-fx="hero-editorial">
    <Hero {...hero} backgroundImage={image} headingId="fx-h-editorial" variant="editorial" />
  </div>

  <div data-fx="body">
    <section class="bg-background py-section-lg" aria-labelledby="fx-cards">
      <div class="mx-auto max-w-content px-m">
        <SectionHeading eyebrow="Cards" headline="Card surfaces" headingId="fx-cards" />
        <div class="mt-l grid gap-m md:grid-cols-3">
          <ServiceCard service={service} />
          <TestimonialCard testimonial={testimonial} /> {/* scaffold: testimonials */}
          <JournalCard entry={entry} /> {/* scaffold: journal */}
        </div>
      </div>
    </section>
    <section class="bg-muted py-section-md" aria-labelledby="fx-density">
      <div class="mx-auto max-w-content px-m">
        <SectionHeading eyebrow="Density" headline="Section rhythm" headingId="fx-density" />
      </div>
    </section>
  </div>

  {/* THE SHARED SPLIT WALL (PORTS.md card 91). Not shot by the visual suite (the pictures are
      fixtures and the copy is not the point); it exists so `node scripts/measure-columns.mjs
      <url> --paths /styleguide/layouts/` has real bands to measure: a picture on each side,
      a text-and-card band, and a plain heading band for the column edge. It sits AFTER every shot region on purpose: the
      screenshots are of element boxes at fractional y, so content placed before them moves their
      height by a pixel and fails the baselines. */}
  <div data-fx="split-bands">
    <SectionHeading
      eyebrow="Columns"
      headline="One split for every band"
      headingId="fx-split"
      class="mx-auto max-w-content px-m py-section-md"
    />
    <ImageText
      image={image}
      imageSide="right"
      eyebrow="Picture right"
      heading="Words on the left"
      body={body}
      headingId="fx-split-right"
    />
    <ImageText
      image={image}
      imageSide="left"
      surface="muted"
      eyebrow="Picture left"
      heading="Words on the right"
      body={body}
      headingId="fx-split-left"
    />
    <ServiceAreaSection
      eyebrow="Text and card"
      headline="A second column that is not a picture"
      description="It starts at the same seam."
      travelFees={[{ distanceLabel: 'Up to 10 miles', fee: 'Included' }]}
      headingId="fx-split-card"
    />
  </div>

  {/* The board head (hero: board, PORTS.md card 188), shot by the hero loop. Its page grammar
      (one ground, section rules) is keyed on html[data-hero='board'], which this page does not
      set, so nothing above it moves. */}
  <div data-fx="hero-board">
    <Hero
      {...hero}
      backgroundImage={image}
      headingId="fx-h-board"
      variant="board"
      scriptAccent="two lines"
    />
  </div>

  {/* THE SHAPE CONTRACT (src/styles/shapes.css, card 188). Not shot: it is here so a reskin can
      see its shape tokens on one page. Neutral defaults: frames on the scale's corners. */}
  <section
    data-fx="shapes"
    class="shape-slab-host bg-background py-section-md"
    aria-labelledby="fx-shapes"
  >
    <div class="mx-auto max-w-content px-m">
      <SectionHeading eyebrow="Shapes" headline="The shape contract" headingId="fx-shapes" />
      <div class="mt-l grid gap-m md:grid-cols-3">
        <a href="/" class="shape-card block">
          <div class="shape-step aspect-[4/3]">
            <div class="shape-zoom bg-secondary"></div>
          </div>
          <p class="mt-s text-sm">.shape-step inside a .shape-card</p>
        </a>
        <div>
          <div class="shape-step shape-tile aspect-[4/3]">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10" fill="currentColor" />
            </svg>
          </div>
          <p class="mt-s text-sm">.shape-tile, a card with no photo</p>
        </div>
        <div class="shape-slab">
          <div class="shape-gable aspect-[5/4.4]">
            <div class="h-full w-full bg-primary"></div>
          </div>
          <p class="mt-s text-sm">.shape-gable over a .shape-slab</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
