  {
    _type: 'dynamicListSection',
    _key: 'dynamic',
    eyebrow: 'Latest',
    headline: 'Recent posts',
    source: 'journal',
    limit: 3,
    items: ['First post', 'Second post', 'Third post'].map((title, i) => ({
      _id: `d${i}`,
      title,
      meta: '2026-01-15',
      summary: 'A short summary of the post.',
      href: '#',
    })),
  },
];
---

<BaseLayout
  title={`Sections wall | ${site.name}`}
  description="Fixed-data wall of every page-builder section. Not for visitors."
  noindex
>
  {SECTIONS.map((section) => (
    <div data-section-type={String(section._type)}>
      <SectionRenderer sections={[section]} idPrefix={`fx-${String(section._key)}`} />
    </div>
  ))}
</BaseLayout>
