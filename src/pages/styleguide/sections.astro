---
// Foundation, edit with care
//
// THE SECTIONS WALL: one of every page-builder block, rendered through the real
// SectionRenderer with FIXED data (the authoring kit, PORTS.md card 109).
//
// WHAT IT IS FOR. `npm run thumbnails` (scripts/shoot-section-thumbnails.mjs)
// shoots each `[data-section-type]` box below into
// public/section-thumbnails/<type>.jpg, and those pictures are what the
// "+ Add item" menu's grid view shows in the Studio. So the picture an editor
// picks from is the block as this site actually draws it, in this site's
// brand, not a generic drawing. Re-run the script after a reskin.
//
// src/lib/authoring.test.ts fails if a block type in sections.ts or
// richSections.ts has no fixture here (it looks for `_type: '<name>'`) or no
// picture on disk, so a new block cannot ship without a thumbnail.
//
// Fixed data on purpose (see styleguide.astro). Collection-fed blocks get their
// collection rows inline, already in the shape the GROQ projection produces.
// The images are fake Sanity references; the script answers the CDN request
// with a local fixture, so no network is needed. NOT shot by the visual suite,
// and like the other walls: noindex, out of the sitemap ('/styleguide' is
// filtered in astro.config.mjs) and under a reserved slug.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { site } from '@/data/site';
import { FIXTURE_RSVP_BLOCK } from '@/lib/mail-fixtures';

const image = (alt = 'Fixture image') => ({
  _type: 'image',
  alt,
  asset: {
    _type: 'reference',
    _ref: 'image-0123456789abcdef0123456789abcdef01234567-1600x900-jpg',
  },
});

const para = (key: string, text: string) => ({
  _type: 'block',
  _key: key,
  style: 'normal',
  markDefs: [],
  children: [{ _type: 'span', _key: `${key}-s`, marks: [], text }],
});

const cta = (label: string) => ({
  _type: 'ctaBlock',
  label,
  linkType: 'external',
  externalUrl: '#',
});

// A small countdown, the kind of thing an editor asks an AI for (card 121).
// Static numbers so the thumbnail does not change from day to day; it uses the
// variables the frame's base stylesheet provides (src/lib/custom-code.ts).
const COUNTDOWN = `<div class="count">
  <p class="label">Vacation Bible School starts in</p>
  <div class="row">
    <div><b>12</b><span>days</span></div>
    <div><b>06</b><span>hours</span></div>
    <div><b>30</b><span>minutes</span></div>
  </div>
</div>
<style>
  .count { text-align: center; padding: 1.5rem 1rem; }
  .label { margin: 0 0 1rem; color: var(--muted-foreground); }
  .row { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .row div { min-width: 5.5rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: #fff; }
  .row b { display: block; font-family: var(--font-display); font-size: 2.5rem; line-height: 1; color: var(--primary); }
  .row span { font-size: 0.875rem; color: var(--muted-foreground); }
</style>`;

// Isolation probes for tests/custom-code.spec.ts (card 121). NOT on the wall
// (no data-section-type), so they are never shot as thumbnails. The boxed probe
// tries to read the page, the site's storage and cookies, and to mark the
// page's <body>; the on-page probe shows what the switch gives up.
const BOXED_PROBE = `<p id="probe">waiting</p>
<script>
  var out = [];
  try { out.push('parent-dom:' + (parent.document.body ? 'READ' : 'none')); } catch (e) { out.push('parent-dom:blocked'); }
  try { parent.document.body.setAttribute('data-custom-code-escaped', 'yes'); } catch (e) {}
  try { out.push('storage:' + (localStorage.getItem('custom-code-secret') === null ? 'empty' : 'READ')); } catch (e) { out.push('storage:blocked'); }
  try { out.push('cookie:' + (document.cookie ? 'READ' : 'empty')); } catch (e) { out.push('cookie:blocked'); }
  document.getElementById('probe').textContent = 'ran ' + out.join(' ');
</script>`;

const ON_PAGE_PROBE = `<p data-on-page-probe>waiting</p>
<script>
  document.querySelector('[data-on-page-probe]').textContent =
    'on page: ' + (localStorage.getItem('custom-code-secret') || 'nothing stored');
</script>`;

const CODE_CHECKS: Record<string, unknown>[] = [
  {
    _type: 'embedSection',
    _key: 'code-boxed',
    headline: 'Boxed code probe',
    heightHint: 'short',
    embedCode: BOXED_PROBE,
  },
  {
    _type: 'embedSection',
    _key: 'code-on-page',
    headline: 'On-page code probe',
    heightHint: 'short',
    embedCode: ON_PAGE_PROBE,
    runsOnPage: true,
  },
];

// Paste-and-go guard (PORTS.md card 172, tests/embed-guard.spec.ts): rendered
// WITHOUT trustedCode, like Sanity content. Script code from an unknown service
// asks to run on the page and must land in its box; a YouTube share link
// becomes the private player at 16:9.
const GUARD_CHECKS: Record<string, unknown>[] = [
  {
    _type: 'embedSection',
    _key: 'guard-unknown',
    headline: 'Unknown script code asking for the page',
    heightHint: 'short',
    embedCode: ON_PAGE_PROBE.replace('data-on-page-probe', 'data-guard-probe').replace(
      '[data-on-page-probe]',
      '[data-guard-probe]',
    ),
    runsOnPage: true,
  },
  {
    _type: 'embedSection',
    _key: 'guard-youtube',
    headline: 'A pasted YouTube link',
    embedUrl: 'https://youtu.be/dQw4w9WgXcQ',
  },
];

