    _key: 'stats',
    heading: 'At a glance',
    stats: [
      { _key: 's1', _type: 'statItem', number: 12, suffix: '+', label: 'years' },
      { _key: 's2', _type: 'statItem', number: 300, label: 'people helped' },
      { _key: 's3', _type: 'statItem', number: 5, label: 'things we do' },
    ],
  },
  {
    _type: 'ctaBandSection',
    _key: 'ctaband',
    eyebrow: 'Next step',
    headline: 'Ready to talk?',
    subhead: 'One line that says what happens when you press the button.',
    cta: cta('Contact us'),
