---

<BaseLayout
  title={`Sections wall | ${site.name}`}
  description="Fixed-data wall of every page-builder section. Not for visitors."
  noindex
>
  {SECTIONS.map((section) => (
    <div data-section-type={String(section._type)}>
      <SectionRenderer
        sections={[section]}
        idPrefix={`fx-${String(section._key)}`}
        anchors="numbered"
      />
    </div>
  ))}
  <div data-custom-code-checks>
    <SectionRenderer sections={CODE_CHECKS} idPrefix="fx-code" anchors="numbered" trustedCode />
  </div>
  <div data-embed-guard-checks>
    <SectionRenderer sections={GUARD_CHECKS} idPrefix="fx-guard" anchors="numbered" />
  </div>
</BaseLayout>
