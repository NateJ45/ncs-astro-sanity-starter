    embedUrl: 'https://embed.example.com/map',
  },
  // scaffold: about
  {
    _type: 'founderSection',
    _key: 'founder',
    eyebrow: 'Meet the founder',
    headline: 'A person, a photo and a few words',
    content: [para('f1', 'A short introduction, in their own voice.')],
