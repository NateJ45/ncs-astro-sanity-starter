---
// Safe to edit by hand for copy + structure changes.
// Contact page. Pulls the contactPage singleton from Sanity.
//
// A page builder since card 190 (ported from FBC Auburn): when the document's Page layout has
// sections, they render through SectionRenderer, and the form is the "Contact form" block
// (src/components/sections/ContactFormSection.astro). With an EMPTY Page layout the page draws
// exactly what it always did: the hero fields, then that same block fed by the document itself.
// So existing content keeps rendering with no migration; scripts/main-pages-builder.mjs seeds
// the Page layout when the editor should be able to rearrange the page.

import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import { getContactPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import Hero from '@/components/Hero.astro';
import ContactFormSection from '@/components/sections/ContactFormSection.astro';

const [page, siteSettings] = await Promise.all([getContactPage(), getSiteSettings()]);

const title = page?.seoTitle ?? `Contact ${site.name}`;
const description = page?.seoDescription ?? 'Start a conversation about your space.';

const heroEyebrow = page?.heroEyebrow ?? 'Request a Consultation.';
const heroHeadline = page?.heroHeadline ?? 'Start the Conversation.';
const heroSubhead = page?.heroSubhead ?? '';

// The Page layout, when the editor has built one. Empty means the classic layout below.
const sections = page?.pageBuilder?.length ? page.pageBuilder : null;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Contact', url: `${site.url}/contact/` },
  ]),
];
---

<BaseLayout {title} {description} {schemas} {siteSettings} seoImage={page?.seoImage}>
  {sections ? (
    <SectionRenderer {sections} idPrefix="contact" />
  ) : (
    <>
      {/* Hero: same image-or-text shape every other page uses. */}
      <Hero
        eyebrow={heroEyebrow}
        headline={heroHeadline}
        subhead={heroSubhead}
        backgroundImage={page?.heroImage}
        headingId="contact-hero-heading"
        size="short"
        scriptAccent={page?.heroScriptAccent}
      />

      <ContactFormSection settings={page} />
    </>
  )}
</BaseLayout>
