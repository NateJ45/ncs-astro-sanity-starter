---
// PORTABLE: canonical copy - ncs-astro-sanity-starter is the library of record for this file
// Foundation, edit with care
// =============================================================================
// CustomCodeFrame: pasted code in its own box (PORTS.md card 121)
// =============================================================================
// Renders editor-pasted HTML/CSS/JS inside an iframe built from `srcdoc`, with
// a sandbox WITHOUT allow-same-origin (src/lib/custom-code.ts FRAME_SANDBOX).
// The frame gets an opaque origin, so the code cannot read the site's cookies
// or localStorage (where the embedded Studio keeps an editor's session) and
// cannot reach the page around it. It still runs scripts, forms, pop-ups and
// alerts, and links open in a new tab (<base target="_blank"> in the srcdoc).
//
// The look: the srcdoc carries a base stylesheet in the site's fonts and LIGHT
// colours, read from brand/brand.config.json and src/sanity/studioFonts.css
// (the same font list the Studio loads, generated by apply-brand). Pasted
// widgets nearly always assume a light background, so in dark mode the frame
// sits on a light panel instead of turning dark under code that cannot follow.
// Font files load from the page's own host (root-relative URLs resolve against
// the embedding page), but from an OPAQUE origin, so each is a CORS request:
// public/_headers sends Access-Control-Allow-Origin on /_astro/*.
//
// Height: the frame posts its height; the listener below accepts it only from
// that frame's own window, only in the known shape, and clamps it. Without
// JavaScript the frame keeps `initialHeight`.
//
// Works in the Presentation preview unchanged: the listener looks the frame up
// when a message arrives, so a frame swapped in by a refresh is still sized.
// =============================================================================
import brand from '../../brand/brand.config.json';
import studioFontCss from '../sanity/studioFonts.css?inline';
import { FRAME_SANDBOX, buildFrameDocument, type FrameTheme } from '@/lib/custom-code';

interface Props {
  /** The pasted code, exactly as the editor wrote it. */
  code: string;
  /** Accessible name for the frame. */
  title: string;
  /** Height in px before the frame reports its own (and without JavaScript). */
  initialHeight?: number;
  class?: string;
}

const { code, title, initialHeight = 320, class: className } = Astro.props;

type Palette = Record<string, string | undefined>;
const b = brand as {
  palette?: { light?: Palette };
  fonts?: { display?: { familyValue?: string }; body?: { familyValue?: string } };
  radius?: string;
};
const light = b.palette?.light ?? {};

const theme: FrameTheme = {
  fontCss: studioFontCss,
  // No assetOrigin on purpose: the font URLs stay root-relative (/_astro/...),
  // and an srcdoc document resolves them against the EMBEDDING page's URL, so
  // they load from whichever host serves the page (workers.dev, the real
  // domain, localhost). Pinning them to Astro.site breaks every other host.
  background: light['--background'],
  foreground: light['--foreground'],
  primary: light['--primary'],
  primaryForeground: light['--primary-foreground'],
  link: light['--link'],
  border: light['--border'],
  mutedForeground: light['--muted-foreground'],
  radius: b.radius,
  fontDisplay: b.fonts?.display?.familyValue,
  fontBody: b.fonts?.body?.familyValue,
};

const srcdoc = buildFrameDocument(code, theme);
const panel = light['--background'] ?? '#ffffff';
---

<div class:list={['custom-code-panel w-full', className]} style={`--custom-code-panel: ${panel}`}>
  <iframe
    data-custom-code-frame
    srcdoc={srcdoc}
    sandbox={FRAME_SANDBOX}
    title={title}
    loading="lazy"
    referrerpolicy="no-referrer"
    allowfullscreen
    class="block w-full border-0"
    style={`height: ${initialHeight}px`}
  ></iframe>
</div>

<style>
  /* Dark mode: a light panel with a little air, so the frame reads as a card. */
  :global(.dark) .custom-code-panel {
    background: var(--custom-code-panel);
    border-radius: var(--radius);
    padding: 1rem;
  }
</style>

<script>
  import { clampFrameHeight, isFrameHeightMessage } from '@/lib/custom-code';

  // One listener for the whole page, installed once even across View
  // Transitions navigations. It never trusts the sender's word: the message
  // must come from the window of one of our frames, from an opaque origin,
  // in the exact { type, height } shape.
  const w = window as Window & { __customCodeFrames?: boolean };
  if (!w.__customCodeFrames) {
    w.__customCodeFrames = true;
    window.addEventListener('message', (event: MessageEvent) => {
      if (event.origin !== 'null' || !event.source) return;
      if (!isFrameHeightMessage(event.data)) return;
      const frames = document.querySelectorAll<HTMLIFrameElement>('iframe[data-custom-code-frame]');
      for (const frame of frames) {
        if (frame.contentWindow !== event.source) continue;
        frame.style.height = `${clampFrameHeight(event.data.height)}px`;
        frame.dataset.sized = 'true';
        return;
      }
    });
  }
</script>
