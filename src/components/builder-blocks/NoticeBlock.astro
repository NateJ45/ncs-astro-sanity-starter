---
// Safe to edit by hand
// Notice band: a short message that shows only between its start and end dates
// (both included, on the site's calendar, `site.timeZone`). The window is checked
// at build time, so a notice goes up and comes down with the next rebuild; a
// small script also hides it in the visitor's browser once its last day has
// passed, so a page cached from yesterday never shows a notice that has ended.
// "Urgent" says what the notice is (a closure, a cancellation); the look follows
// from that here, not from a colour field (rule 9). Self-contained: it draws its
// own slim band outside the page cadence (sectionCadence.ts).
import CtaLink from '@/components/CtaLink.astro';
import { inDateWindow, isoDay, noticeParts, plain, siteToday } from '@/lib/builder-blocks';
import { site } from '@/data/site';
import type { ProjectedNoticeSection } from '@/lib/builderBlocks.types';

interface Props {
  block: ProjectedNoticeSection;
  /** The build moment; tests pass a fixed one. */
  now?: Date;
}
const { block, now = new Date() } = Astro.props;
const message = block.message?.trim();
const showing =
  Boolean(message) && inDateWindow(block.startDate, block.endDate, siteToday(now, site.timeZone));
const urgent = plain(block.urgency) === 'urgent';
const end = isoDay(block.endDate);
const tag = block.label?.trim() || (urgent ? 'Urgent' : 'Notice');
const parts = noticeParts(message);
---

{showing && (
  <aside
    class:list={['bb-notice', urgent && 'bb-notice--urgent']}
    aria-label={block.label?.trim() || (urgent ? 'Urgent notice' : 'Notice')}
    data-builder-block="noticeSection"
    data-bb-notice-end={end || undefined}
    data-zone={site.timeZone}
  >
    <div class="bb-notice__inner mx-auto max-w-content px-m">
      <span class="bb-notice__tag">{tag}</span>
      <p class="bb-notice__message">
        {parts.map((p) =>
          p.tel ? (
            <a class="bb-notice__tel" href={p.tel}>
              {p.text}
            </a>
          ) : (
            p.text
          ),
        )}
      </p>
      {block.link?.label && <CtaLink cta={block.link} variant="secondary" />}
    </div>
  </aside>
)}

<script>
  // Hide a notice whose last day has passed on the site's calendar.
  function expireNotices() {
    for (const el of document.querySelectorAll<HTMLElement>('[data-bb-notice-end]')) {
      const today = new Intl.DateTimeFormat('en-CA', {
        timeZone: el.dataset.zone || undefined,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).format(new Date());
      if (today > (el.dataset.bbNoticeEnd ?? '9999')) el.hidden = true;
    }
  }
  expireNotices();
  document.addEventListener('astro:page-load', expireNotices);
</script>
