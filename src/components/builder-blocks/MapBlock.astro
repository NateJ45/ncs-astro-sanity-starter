---
// Safe to edit by hand
// Map and directions (builderSections.ts mapSection, PORTS.md card 196, from
// first-baptist-auburn's "Getting here" map card). A drawn map, not an embedded
// one: a soft street grid in the theme's own colors with a pin, the address from
// Business info, and Directions (Google Maps) and Apple Maps buttons. Nothing
// loads from a map service and nothing tracks a visitor until they choose a
// button, so it needs no consent banner and no CSP change. Today's hours sit
// under the address when the site has hours.
//
// Draws nothing without a street address in Business info.
import { MapPin } from 'lucide-react';
import BuilderBand from './BuilderBand.astro';
import CtaLink from '@/components/CtaLink.astro';
import OpenStatus from '@/components/business/OpenStatus.astro';
import BusinessAddress from '@/components/business/BusinessAddress.astro';
import { factsFor } from '@/lib/business-data';
import type { CadenceSurface } from '@/lib/surfaces';
import type { ProjectedMapSection } from '@/lib/builderBlocks.types';
import '@/styles/business.css';

interface Props {
  block: ProjectedMapSection;
  surface?: CadenceSurface;
  headingId: string;
  /** The page's one accent button (card 158), when SectionRenderer hands it to this block. */
  primaryVariant?: 'primary' | 'secondary';
}
const { block, surface, headingId, primaryVariant = 'secondary' } = Astro.props;
const facts = await factsFor(block.facts);
const address = facts.address;
const directions = address
  ? {
      label: 'Directions',
      linkType: 'external' as const,
      externalUrl: address.mapsUrl,
      openInNewTab: true,
    }
  : null;
---

{address && (
  <BuilderBand
    type={block._type}
    heading={block.heading}
    intro={block.intro}
    headingId={headingId}
    surface={surface}
    label={`Map: ${address.oneLine}`}
  >
    <div class="biz-map">
      <div class="biz-map__art" aria-hidden="true">
        <MapPin size={56} strokeWidth={1.5} className="biz-map__pin" />
      </div>
      <div class="biz-map__body">
        <BusinessAddress address={address} links={false} />
        {block.showHours !== false && <OpenStatus facts={facts} />}
        <div class="bb-actions biz-map__actions">
          <CtaLink cta={directions} variant={primaryVariant} />
          <a
            class="biz-map__apple"
            href={address.appleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Apple Maps<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </BuilderBand>
)}
