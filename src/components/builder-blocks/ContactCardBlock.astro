---
// Safe to edit by hand
// Contact details on one card (PORTS.md card 193, from FBC Auburn's contact block): phone, email,
// address (with a directions link) and opening hours, a column each on a wide screen. The phone
// and email, the address and the opening hours default to the site's business facts (Site
// settings and Business info, card 196, rule 15: typed once), so a bare block fills itself; a
// block can type its own for a department or a second location and that wins. A fact still
// marked unconfirmed carries the "To confirm" tag (only when it came from the facts, never from
// the block's own words). Hours from the facts show as "Today 9 am to 5 pm" plus the live status
// ("Open now until 5 pm", "Opens tomorrow at 9 am") the Opening hours block uses. Lines that are
// empty are left out, and with none at all the block draws nothing.
//
// "Lead with big Call and Email buttons" (callButtons) puts two large buttons above the details,
// tel: and mailto: links built from the same two values. Call is the page's one accent button when
// SectionRenderer hands this block the accent (primaryVariant, card 158); Email is the outline.
import BuilderBand from './BuilderBand.astro';
import CtaLink from '@/components/CtaLink.astro';
import OpenStatus from '@/components/business/OpenStatus.astro';
import ToConfirm from '@/components/business/ToConfirm.astro';
import { factsFor } from '@/lib/business-data';
import { eventPlace, plain, telHref } from '@/lib/builder-blocks';
import type { CadenceSurface } from '@/lib/surfaces';
import type { ProjectedContactCardSection } from '@/lib/builderBlocks.types';

interface Props {
  block: ProjectedContactCardSection;
  surface?: CadenceSurface;
  headingId: string;
  primaryVariant?: 'primary' | 'secondary';
}
const { block, surface, headingId, primaryVariant = 'secondary' } = Astro.props;

const facts = await factsFor(block.facts);
// Own words win; the facts fill whatever is left empty.
const ownPhone = plain(block.phone);
const phone = ownPhone || facts.phone?.display || '';
const tel = telHref(phone);
const phoneTag = !ownPhone && facts.phone ? facts.phone.confirmed : null;
const ownEmail = plain(block.email);
const email = ownEmail || facts.email?.address || '';
const emailTag = !ownEmail && facts.email ? facts.email.confirmed : null;
const ownPlace = eventPlace(block.address);
const place =
  ownPlace ??
  (facts.address ? { lines: facts.address.lines, mapsUrl: facts.address.mapsUrl } : null);
const placeTag = !ownPlace && facts.address ? facts.address.confirmed : null;
const hours = plain(block.hours)
  .split(/\r?\n/)
  .map((l) => l.trim())
  .filter(Boolean);
const factHours = hours.length === 0 && facts.hasHours;

const count = [Boolean(tel), Boolean(email), Boolean(place), hours.length > 0 || factHours].filter(
  Boolean,
).length;
const big = block.callButtons === true;
---

{count > 0 && (
  <BuilderBand
    type={block._type}
    heading={block.heading}
    intro={block.intro}
    headingId={headingId}
    surface={surface}
    label="Contact details"
  >
    {big && (tel || email) && (
      <div class="bb-call" data-call-buttons>
        {tel && (
          <CtaLink
            cta={{ label: `Call ${phone}`, linkType: 'phone', phoneNumber: phone }}
            variant={primaryVariant === 'primary' ? 'primary' : 'secondary'}
            class="bb-call__btn"
          />
        )}
        {email && (
          <CtaLink
            cta={{ label: 'Email us', linkType: 'email', emailAddress: email }}
            variant="secondary"
            class="bb-call__btn"
          />
        )}
      </div>
    )}
    <dl class="bb-board" data-n={count}>
      {tel && (
        <div class="bb-board__cell">
          <dt>Phone</dt>
          <dd>
            <a href={tel}>{phone}</a>
            <ToConfirm confirmed={phoneTag} />
          </dd>
        </div>
      )}
      {email && (
        <div class="bb-board__cell">
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${email}`}>{email}</a>
            <ToConfirm confirmed={emailTag} />
          </dd>
        </div>
      )}
      {place && (
        <div class="bb-board__cell">
          <dt>Address</dt>
          <dd>
            {place.lines.map((line) => (
              <span class="bb-line">{line}</span>
            ))}
            <ToConfirm confirmed={placeTag} />
            <a href={place.mapsUrl} target="_blank" rel="noopener noreferrer">
              Get directions<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </dd>
        </div>
      )}
      {(hours.length > 0 || factHours) && (
        <div class="bb-board__cell">
          <dt>Opening hours</dt>
          <dd>
            {hours.map((line) => (
              <span class="bb-line">{line}</span>
            ))}
            {factHours && <OpenStatus facts={facts} />}
            {factHours && facts.hoursNote && <span class="bb-line">{facts.hoursNote}</span>}
          </dd>
        </div>
      )}
    </dl>
  </BuilderBand>
)}
