---
// Foundation, edit with care
// Renders a page-builder section array. Maps each block _type to its component
// and OWNS the alternating background cadence for content blocks, so reordering
// can never break the page rhythm (that is why blocks have no color field). A
// content block's `look` (src/lib/section-looks.ts, rule 9 as amended) is a
// request the cadence resolves into a measured surface, never a colour.
// Self-contained blocks (hero, CTA band, stats, spacer) manage their own surface.
//
// Cadence logic lives in src/lib/sectionCadence.ts and is unit-tested separately.
// This file is thin template glue: it imports classified rows and delegates.
//
// The GROQ query that loads `sections` must project images with imageProjection
// and ctaBlocks with ctaProjection (see sectionsProjection() in queries.ts).
import Hero from '@/components/Hero.astro';
import FinalCta from '@/components/FinalCta.astro';
import StatsRow from '@/components/StatsRow.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import BoardRule from '@/components/board/BoardRule.astro';
import { layout } from '@/data/layout';
import { isBoard } from '@/lib/site-layout';
import RichTextSection from '@/components/sections/RichTextSection.astro';
import ImageText from '@/components/sections/ImageText.astro';
import GalleryGrid from '@/components/sections/GalleryGrid.astro';
import QuoteBlock from '@/components/sections/QuoteBlock.astro';
import VideoEmbed from '@/components/sections/VideoEmbed.astro';
import FounderSection from '@/components/sections/FounderSection.astro'; // scaffold: about
import ServicesGridSection from '@/components/sections/ServicesGridSection.astro'; // scaffold: services
import TestimonialsSection from '@/components/sections/TestimonialsSection.astro'; // scaffold: testimonials
import StorySection from '@/components/sections/StorySection.astro'; // scaffold: about
import ValuesSection from '@/components/sections/ValuesSection.astro'; // scaffold: philosophy
import ProcessSection from '@/components/sections/ProcessSection.astro'; // scaffold: process
import ServiceAreaSection from '@/components/sections/ServiceAreaSection.astro';
import GuaranteeSection from '@/components/sections/GuaranteeSection.astro';
import FaqSection from '@/components/sections/FaqSection.astro'; // scaffold: faq
import LogoStrip from '@/components/sections/LogoStrip.astro';
import TeamGrid from '@/components/sections/TeamGrid.astro';
import EmbedSection from '@/components/sections/EmbedSection.astro';
import DynamicList from '@/components/sections/DynamicList.astro';
import RsvpSection from '@/components/sections/RsvpSection.astro';
import LatestVideo from '@/components/sections/LatestVideo.astro';
import DocumentsList from '@/components/sections/DocumentsList.astro'; // scaffold: documents
// Every main page a page builder (card 190): the pieces Contact, Privacy and Journal drew in code.
import ContactFormSection from '@/components/sections/ContactFormSection.astro';
import PrivacyPolicy from '@/components/sections/PrivacyPolicy.astro';
import JournalPosts from '@/components/sections/JournalPosts.astro'; // scaffold: journal
import FormSection from '@/components/sections/FormSection.astro';
import BuilderBlock from '@/components/builder-blocks/BuilderBlock.astro';
import { isBuilderBlock } from '@/lib/builderBlocks.types';
import { classifySections } from '@/lib/sectionCadence';
import { sectionAnchors, sectionHeadingText } from '@/lib/section-anchors';
import { primaryBudget, repeatsHeaderCta } from '@/lib/cta-budget';
import { ctaHref } from '@/lib/cta-href';
import { getSiteSettings } from '@/lib/queries';
import { resolveSiteSettings } from '@/lib/siteSettings';
import { expandSyncedSections } from '@/lib/authoring';
import type { PageBuilderBlock } from '@/lib/pageBuilder.types';
import { SECTION_DRAG_FLOW, sectionEditAttr, type EditDoc } from '@/lib/preview-edit-attr';

interface Props {
  sections?: unknown[];
  /** Prefix for generated heading ids, so two renderers on a page do not collide. */
  idPrefix?: string;
  /**
   * PREVIEW ONLY. When the Studio preview route passes the document each
   * section belongs to, every section is wrapped in a real block box carrying a
   * `data-sanity` attribute, which is what gives the Presentation overlay its
   * in-canvas insert / duplicate / remove / drag-to-reorder controls
   * (PORTS.md card 17).
   *
   * The live pages never pass it, and with it absent the wrapper is a
   * `<Fragment>`, which renders NOTHING at all. That is why the static build's
   * markup stays byte-identical with this feature installed, and
   * `npm run parity compare` is the standing gate on that promise.
   */
  editDoc?: EditDoc;
  /**
   * 'named' (the default): a section with a heading takes an id made from it,
   * so /about/#our-story links to it (src/lib/section-anchors.ts, card 158).
   * 'numbered': every section keeps `<idPrefix>-<n>`. Pages that draw several
   * renderers (the styleguide fixtures) pass 'numbered' so their ids stay unique.
   */
  anchors?: 'named' | 'numbered';
  /**
   * Custom code written IN THIS REPO (the styleguide's isolation probes), not
   * pasted by an editor: it may run on the page without being from a known
   * service (src/lib/embed-providers.ts, PORTS.md card 172). Never set for
   * Sanity content.
   */
  trustedCode?: boolean;
}

const {
  sections = [],
  idPrefix = 'section',
  editDoc,
  anchors = 'named',
  trustedCode = false,
} = Astro.props as Props;
// Synced sections (the authoring kit, PORTS.md card 109) are swapped for the
// sections their saved copy holds BEFORE the cadence runs, so a synced band
// takes its place in the alternating rhythm like any typed-in band (rule 9).
// The business blocks (story, service area, guarantee) take no look, so the
// cadence only ever hands them a light surface; this narrows the type for them.
const lightSurface = (s: string | null): 'background' | 'muted' =>
  s === 'muted' ? 'muted' : 'background';

const classified = classifySections<PageBuilderBlock>(
  expandSyncedSections(sections as PageBuilderBlock[]),
  idPrefix,
);
// Named anchors (card 158): a section with a heading takes a unique id made
// from it, the rest keep the numbered one. Stega is stripped inside, so the
// draft preview gets the live page's ids.
const anchorIds =
  anchors === 'named'
    ? sectionAnchors(
        classified.map(({ block, headingId }) => ({
          key: (block as { _key?: string })._key,
          heading: sectionHeadingText(block),
          fallback: headingId,
        })),
      )
    : classified.map(({ headingId }) => headingId);
const rows = classified.map((row, i) => ({ ...row, headingId: anchorIds[i] }));

// One accent button per page (src/lib/cta-budget.ts, card 158): the first
// section that draws a primary button keeps it; every later one draws the
// secondary variant. A closing band always draws one (CtaLink has a fallback).
// A Hero or FinalCta a page draws OUTSIDE this renderer is not counted.
// An event's main button (the builder kit, card 173) counts too.
// The header's button keeps the accent on every page (card 187), so a body
// button that goes where the header button goes repeats it and draws secondary
// without spending the budget: the accent passes to the page's own next step.
const headerCta = resolveSiteSettings(await getSiteSettings()).headerCta;
const own = (href: string) => !repeatsHeaderCta(href, headerCta);
const ctaVariant = primaryBudget(rows, ({ block }) =>
  block._type === 'ctaBandSection'
    ? // A button left empty draws nothing (CtaLink), so it cannot hold the accent either.
      !(block.cta && !block.cta.label && !block.cta.linkType && !block.cta.href) &&
      own(ctaHref(block.cta))
    : block._type === 'heroSection'
      ? !!block.primaryCta && own(ctaHref(block.primaryCta))
      : block._type === 'eventDetailsSection'
        ? !!block.button?.label && own(ctaHref(block.button))
        : // Card 193: the contact card's big Call button, and the steps rail's closing button.
          block._type === 'contactCardSection'
          ? block.callButtons === true
          : block._type === 'stepsRailSection' && !!block.link?.label && own(ctaHref(block.link)),
);

// The board grammar (brand.config.json layout.hero = 'board', card 188): every section opens with
// a rule (BoardRule) on one ground, in place of the cadence's divider. Not before the first
// section, not before or straight after a hero (the page head has its own spacing), and not
// before a spacer, which is a break of its own. Off on every other site, so nothing changes.
const board = isBoard(layout);
const UNRULED = new Set(['heroSection', 'spacerSection']);
const ruled = rows.map(
  ({ block }, i) =>
    board && i > 0 && !UNRULED.has(block._type) && rows[i - 1].block._type !== 'heroSection',
);

// A real element in preview, nothing at all on the live site. The wrapper must
// NOT be `display: contents`: the overlay outlines the element's rect, and a
// contents element has none. A plain block-level div around a full-width
// <section> changes no layout.
const Wrap = editDoc ? 'div' : Fragment;
const wrapAttrs = (key: string | undefined) =>
  editDoc && key ? { 'data-sanity': sectionEditAttr(editDoc, key), ...SECTION_DRAG_FLOW } : {};
// A section that came out of a synced section is not in the page itself; its
// in-canvas controls act on the synced block it came from, which is.
const editKeyOf = (block: unknown) => {
  const b = block as { _key?: string; _editKey?: string };
  return b._editKey ?? b._key;
};
---

{rows.map(({ block: s, surface, insertDividerBefore, headingId }, rowIndex) => (
  <>
    {insertDividerBefore && !board && <SectionDivider />}
    {ruled[rowIndex] && <BoardRule />}

    <Wrap {...wrapAttrs(editKeyOf(s))}>
      {isBuilderBlock(s) ? (
        // The builder kit (PORTS.md card 173): one branch, BuilderBlock picks the component.
        <BuilderBlock
          block={s}
          surface={surface ?? 'background'}
          headingId={headingId}
          primaryVariant={ctaVariant(rowIndex)}
          isFirst={rowIndex === 0}
        />
      ) : s._type === 'heroSection' ? (
        <Hero
          eyebrow={s.eyebrow}
          headline={s.headline ?? ''}
          subhead={s.subhead}
          backgroundImage={s.backgroundImage}
          primaryCta={s.primaryCta}
          secondaryCta={s.secondaryCta}
          scriptAccent={s.scriptAccent}
          size={s.size ?? 'short'}
          headingId={headingId}
          primaryVariant={ctaVariant(rowIndex)}
          heroStyle={s.heroStyle}
          glance={s.glance}
          backgroundVideo={s.backgroundVideo}
          backgroundVideoPhone={s.backgroundVideoPhone}
        />
      ) : s._type === 'ctaBandSection' ? (
        <FinalCta
          eyebrow={s.eyebrow}
          headline={s.headline}
          subhead={s.subhead}
          subheadRich={s.subheadRich}
          cta={s.cta}
          scriptAccent={s.scriptAccent}
          headingAccent={s.headingAccent}
          backgroundImage={s.backgroundImage}
          headingId={headingId}
          primaryVariant={ctaVariant(rowIndex)}
        />
      ) : s._type === 'statSection' ? (
        <StatsRow
          stats={
            (s.stats ?? []).filter((x) => typeof x?.number === 'number') as {
              number: number;
              suffix?: string;
              label: string;
            }[]
          }
        />
      ) : s._type === 'spacerSection' ? (
        s.variant === 'space' ? (
          <div class="py-section-md" aria-hidden="true" />
        ) : (
          <SectionDivider variant={s.variant === 'line' ? 'line' : 'ornament'} />
        )
      ) : s._type === 'richTextSection' ? (
        <RichTextSection
          eyebrow={s.eyebrow}
          heading={s.heading}
          scriptAccent={s.scriptAccent}
          headingAccent={s.headingAccent}
          body={s.body}
          width={s.width}
          align={s.align}
          surface={surface ?? 'background'}
          headingId={headingId}
        />
      ) : s._type === 'imageTextSection' ? (
        <ImageText
          image={s.image}
          imageSide={s.imageSide}
          eyebrow={s.eyebrow}
          heading={s.heading}
          body={s.body}
          cta={s.cta}
          surface={surface ?? 'background'}
          headingId={headingId}
        />
      ) : s._type === 'gallerySection' ? (
        <GalleryGrid
          heading={s.heading}
          images={s.images}
          columns={s.columns}
          surface={surface ?? 'background'}
          headingId={headingId}
        />
      ) : s._type === 'quoteSection' ? (
        <QuoteBlock
          quote={s.quote}
          attribution={s.attribution}
          detail={s.detail}
          surface={surface ?? 'background'}
        />
      ) : s._type === 'videoSection' ? (
        <VideoEmbed
          url={s.url}
          heading={s.heading}
          caption={s.caption}
          surface={surface ?? 'background'}
          headingId={headingId}
        />
      ) : // scaffold-branch: about
      s._type === 'founderSection' ? (
        <FounderSection
          portrait={s.portrait}
          eyebrow={s.eyebrow}
          headline={s.headline}
          content={s.content}
          cta={s.cta}
          headingId={headingId}
        />
      ) : // scaffold-branch: services
      s._type === 'servicesGridSection' ? (
        <ServicesGridSection
          eyebrow={s.eyebrow}
          headline={s.headline}
          scriptAccent={s.scriptAccent}
          headingAccent={s.headingAccent}
          subhead={s.subhead}
          subheadRich={s.subheadRich}
          services={s.services ?? []}
          cta={s.cta}
          footnote={s.footnote}
          variant={s.variant ?? 'grid'}
          headingId={headingId}
        />
      ) : // scaffold-branch: testimonials
      s._type === 'testimonialsSection' ? (
        <TestimonialsSection
          eyebrow={s.eyebrow}
          headline={s.headline}
          scriptAccent={s.scriptAccent}
          headingAccent={s.headingAccent}
          subhead={s.subhead}
          subheadRich={s.subheadRich}
          featuredQuote={s.featuredQuote}
          testimonialsToShow={s.testimonialsToShow ?? []}
          attribution={s.attribution}
          headingId={headingId}
        />
      ) : // scaffold-branch: about
      s._type === 'storySection' ? (
        <StorySection
          eyebrow={s.eyebrow}
          headline={s.headline}
          content={s.content}
          portrait={s.portrait}
          attribution={s.attribution}
          credentialLine={s.credentialLine}
          serviceAreaLine={s.serviceAreaLine}
          surface={lightSurface(surface)}
          headingId={headingId}
        />
      ) : // scaffold-branch: philosophy
      s._type === 'valuesSection' ? (
        <ValuesSection
          eyebrow={s.eyebrow}
          headline={s.headline}
          points={s.points ?? []}
          columns={s.columns}
          headingId={headingId}
        />
      ) : // scaffold-branch: process
      s._type === 'processSection' ? (
        <ProcessSection
          eyebrow={s.eyebrow}
          headline={s.headline}
          subhead={s.subhead}
          steps={s.steps ?? []}
          variant={s.variant ?? 'preview'}
          cta={s.cta}
          headingId={headingId}
        />
      ) : s._type === 'serviceAreaSection' ? (
        <ServiceAreaSection
          eyebrow={s.eyebrow}
          headline={s.headline}
          description={s.description}
          travelFees={s.travelFees ?? []}
          showTravelFees={s.showTravelFees ?? true}
          surface={lightSurface(surface)}
          headingId={headingId}
        />
      ) : s._type === 'guaranteeSection' ? (
        <GuaranteeSection
          text={s.text}
          siteSettingsText={s.siteSettingsText}
          surface={lightSurface(surface)}
        />
      ) : // scaffold-branch: faq
      s._type === 'faqSection' ? (
        <FaqSection
          eyebrow={s.eyebrow}
          headline={s.headline}
          headingAccent={s.headingAccent}
          subhead={s.subhead}
          subheadRich={s.subheadRich}
          items={s.items ?? []}
          cta={s.cta}
          headingId={headingId}
        />
      ) : s._type === 'logoStripSection' ? (
        <LogoStrip
          eyebrow={s.eyebrow}
          headline={s.headline}
          logos={s.logos ?? []}
          layout={s.layout ?? 'row'}
          headingId={headingId}
        />
      ) : s._type === 'teamSection' ? (
        <TeamGrid
          eyebrow={s.eyebrow}
          headline={s.headline}
          subhead={s.subhead}
          subheadRich={s.subheadRich}
          members={s.members ?? []}
          headingId={headingId}
        />
      ) : s._type === 'rsvpSection' ? (
        <RsvpSection block={s} surface={surface ?? 'background'} headingId={headingId} />
      ) : s._type === 'latestVideoSection' ? (
        <LatestVideo block={s} surface={surface ?? 'background'} headingId={headingId} />
      ) : // scaffold-branch: documents
      s._type === 'documentsSection' ? (
        <DocumentsList
          heading={s.heading}
          intro={s.intro}
          category={s.category}
          limit={s.limit}
          showDates={s.showDates}
          items={s.items ?? []}
          surface={surface ?? 'background'}
          headingId={headingId}
        />
      ) : s._type === 'formSection' ? (
        <FormSection block={s} surface={surface ?? 'background'} headingId={headingId} />
      ) : s._type === 'embedSection' ? (
        <EmbedSection
          eyebrow={s.eyebrow}
          headline={s.headline}
          subhead={s.subhead}
          embedUrl={s.embedUrl}
          embedCode={s.embedCode}
          runsOnPage={s.runsOnPage === true}
          trustedCode={trustedCode}
          heightHint={s.heightHint ?? 'medium'}
          headingId={headingId}
        />
      ) : s._type === 'contactFormSection' ? (
        <ContactFormSection settings={s.settings} sidebar={s.sidebar !== false} />
      ) : s._type === 'privacyPolicySection' ? (
        <PrivacyPolicy lastUpdated={s.lastUpdated} body={s.body} />
      ) : // scaffold-branch: journal
      s._type === 'journalPostsSection' ? (
        <JournalPosts
          showCategories={s.showCategories !== false}
          showNewsletter={s.showNewsletter !== false}
          headingId={headingId}
        />
      ) : s._type === 'dynamicListSection' ? (
        <DynamicList
          eyebrow={s.eyebrow}
          headline={s.headline}
          subhead={s.subhead}
          subheadRich={s.subheadRich}
          source={s.source}
          items={s.items ?? []}
          cta={s.cta}
          columns={s.columns}
          limit={s.limit}
          headingId={headingId}
        />
      ) : (
        // Unknown block type: render nothing, log in dev.
        import.meta.env.DEV &&
        console.warn(
          // `s` is `never` here: every member of PageBuilderBlock is handled
          // above, which is exactly what this branch exists to prove. The cast
          // is only so the runtime warning can name the type Sanity actually
          // sent when a NEW block ships without a mapping. Written as a
          // Record rather than an inline object type on purpose: a brace
          // inside an .astro template expression ends that expression, even
          // inside a comment, so an inline object type breaks the parse.
          `[SectionRenderer] Unknown block type: "${(s as Record<string, unknown>)._type}". Add a mapping in SectionRenderer.astro.`,
        )
      )}
    </Wrap>
  </>
))}
