---
// Foundation, edit with care
// Site footer. Compact layout that reads as a SEPARATE zone from the FinalCta
// section that sits above it on most pages.
//
// Color decoupling: the footer uses bg-muted (Cream in light, dark warm in
// dark) so it doesn't visually merge with the Charcoal Dark FinalCta. The
// 4px Warm Bronze accent stripe at the top is the same brand signature
// used in the header and mobile menu drawer.
//
// Structure (top to bottom):
//   1. Bronze accent stripe
//   2. Optional newsletter signup (only when siteSettings.newsletter.enabled)
//   3. Compact brand bar: logo + tagline side by side (one short row, not a
//      tall stacked block) so the footer stays roughly half its old height.
//   4. Five-column link grid: Studio / Work / Free tools / Latest projects /
//      Get in touch (email, phone, location, socials).
//   5. Thin bottom bar: auto-year copyright, privacy link, optional "Site
//      by..." credit, all on one line.
//
// Tailwind v4 gotcha: max-w-xs/s/m/l are shadowed by this project's custom
// --spacing-* tokens (they resolve to a few px, not the container scale). Use
// max-w-md / max-w-2xl / arbitrary values like max-w-[28rem] for text widths.
//
// Latest projects pull from Sanity. Gracefully degrades to a "see portfolio"
// message when nothing is published yet.

import { getImage } from 'astro:assets';
import { site } from '@/data/site';
import { IconBrandInstagram, IconBrandFacebook } from '@tabler/icons-react';
import { Mail, Phone } from 'lucide-react';
import CopyEmailButton from '@/components/CopyEmailButton';
import NewsletterSignup from '@/components/NewsletterSignup';
import { getAllProjects, type CoreProjectCard } from '@/lib/queries';
import logoLightAsset from '@/assets/logo-light.png';
import logoDarkAsset from '@/assets/logo-dark.png';
import { getSectionVisibility } from '@/lib/sectionVisibility';
import { telHref } from '@/lib/phone';

// Pre-render the four footer-logo variants (1x + 2x for each theme) so we
// can ship ONE img tag with data-attribute URLs and let the BaseLayout
// anti-FOUC script pick the right variant — same trick as the header.
// Footer logo displays at h-16 (64 px tall); the 96w/192w pair still covers retina.
const footerLogoLight1x = await getImage({ src: logoLightAsset, format: 'webp', width: 96 });
const footerLogoLight2x = await getImage({ src: logoLightAsset, format: 'webp', width: 192 });
const footerLogoDark1x = await getImage({ src: logoDarkAsset, format: 'webp', width: 96 });
const footerLogoDark2x = await getImage({ src: logoDarkAsset, format: 'webp', width: 192 });
const footerLogoLightSrcset = `${footerLogoLight1x.src} 1x, ${footerLogoLight2x.src} 2x`;
const footerLogoDarkSrcset = `${footerLogoDark1x.src} 1x, ${footerLogoDark2x.src} 2x`;

interface NewsletterConfig {
  enabled?: boolean;
  heading?: string;
  blurb?: string;
  buttonLabel?: string;
  successMessage?: string;
  consentNote?: string;
  formActionUrl?: string | null;
  audienceId?: string | null;
}

interface Props {
  siteSettings?: {
    title?: string;
    email?: string;
    phone?: string;
    socialInstagram?: string;
    socialFacebook?: string;
    serviceAreas?: string[];
    tagline?: string;
    footerCredit?: string;
    footerCreditUrl?: string;
    newsletter?: NewsletterConfig | null;
    sectionVisibility?: {
      showPortfolio?: boolean | null;
      showJournal?: boolean | null;
      showShop?: boolean | null;
      showEDesign?: boolean | null;
      showGiftCertificates?: boolean | null;
      showPress?: boolean | null;
      showResources?: boolean | null;
      showGuides?: boolean | null;
      showStyleQuiz?: boolean | null;
      showBudgetCalculator?: boolean | null;
    } | null;
  } | null;
}

const { siteSettings } = Astro.props as Props;

// Normalize section visibility. Unset => visible (safe default for live site).
const visible = getSectionVisibility(siteSettings?.sectionVisibility);

const brandName = siteSettings?.title ?? site.name;
const email = siteSettings?.email ?? '';
const phone = siteSettings?.phone ?? '';
const ig = siteSettings?.socialInstagram ?? '';
const fb = siteSettings?.socialFacebook ?? '';
// Copyright auto-updates every build via new Date(). The "Site by..." line
// (siteCredit + siteCreditUrl) is a SEPARATE concept that sits next to the
// auto-year copyright in the thin bottom bar.
const currentYear = new Date().getFullYear();
const siteCredit = siteSettings?.footerCredit;
const siteCreditUrl = siteSettings?.footerCreditUrl;

// Pull the three most recent projects for the Latest Projects column.
// Falls back to an empty array when Sanity isn't reachable (build won't fail).
const allProjects: CoreProjectCard[] = (await getAllProjects().catch(() => [])) ?? [];
const latestProjects = allProjects.slice(0, 3);
---

<footer class="bg-muted text-foreground">
  {/* Brand accent stripe — matches header + mobile drawer. */}
  <div class="h-1 bg-primary" aria-hidden="true"></div>

  {/* Newsletter signup — renders only when siteSettings.newsletter.enabled is
       true. Island hydrates when scrolled into view. */}
  {siteSettings?.newsletter?.enabled && (
    <div class="mx-auto max-w-content px-m pt-l">
      <div class="max-w-md mx-auto">
        <NewsletterSignup
          client:visible
          newsletter={siteSettings.newsletter}
          source="footer"
        />
      </div>
    </div>
  )}

  {/* Five-column link grid. Single centered column on mobile, five columns
       at md+ (left-aligned). The fifth column carries contact details. */}
  <div class="mx-auto max-w-content px-m pt-l pb-m grid gap-l grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 text-center md:text-left">
    {/* STUDIO */}
    <nav aria-labelledby="footer-studio">
      <p id="footer-studio" class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">
        Studio
      </p>
      <ul class="text-sm space-y-2 list-none p-0">
        <li><a href="/about" class="text-foreground/85 hover:text-link transition-colors">About</a></li>
        <li><a href="/process" class="text-foreground/85 hover:text-link transition-colors">Process</a></li>
        <li><a href="/services" class="text-foreground/85 hover:text-link transition-colors">Services &amp; Pricing</a></li>
        <li><a href="/faq" class="text-foreground/85 hover:text-link transition-colors">FAQ</a></li>
        {visible.press && (
          <li><a href="/press" class="text-foreground/85 hover:text-link transition-colors">Press</a></li>
        )}
      </ul>
    </nav>

    {/* WORK */}
    <nav aria-labelledby="footer-work">
      <p id="footer-work" class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">
        Work
      </p>
      <ul class="text-sm space-y-2 list-none p-0">
        {visible.portfolio && (
          <li><a href="/portfolio" class="text-foreground/85 hover:text-link transition-colors">Portfolio</a></li>
        )}
        {visible.portfolio && (
          <li><a href="/portfolio/before-after" class="text-foreground/85 hover:text-link transition-colors">Before &amp; After</a></li>
        )}
        {visible.journal && (
          <li><a href="/journal" class="text-foreground/85 hover:text-link transition-colors">Journal</a></li>
        )}
        {visible.shop && (
          <li><a href="/shop" class="text-foreground/85 hover:text-link transition-colors">Shop</a></li>
        )}
        {visible.giftCertificates && (
          <li><a href="/gift-certificates" class="text-foreground/85 hover:text-link transition-colors">Gift Certificates</a></li>
        )}
      </ul>
    </nav>

    {/* FREE TOOLS & GUIDES */}
    <nav aria-labelledby="footer-tools">
      <p id="footer-tools" class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">
        Free tools &amp; guides
      </p>
      <ul class="text-sm space-y-2 list-none p-0">
        {visible.styleQuiz && (
          <li><a href="/quiz" class="text-foreground/85 hover:text-link transition-colors">Style Quiz</a></li>
        )}
        {visible.budgetCalculator && (
          <li><a href="/calculator" class="text-foreground/85 hover:text-link transition-colors">Cost Calculator</a></li>
        )}
        {visible.guides && (
          <li><a href="/guides" class="text-foreground/85 hover:text-link transition-colors">Guides</a></li>
        )}
        {visible.resources && (
          <li><a href="/resources" class="text-foreground/85 hover:text-link transition-colors">Resources</a></li>
        )}
      </ul>
    </nav>

    {/* LATEST PROJECTS — only when portfolio is visible. */}
    {visible.portfolio ? (
      <nav aria-labelledby="footer-latest">
        <p id="footer-latest" class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">
          Latest projects
        </p>
        {latestProjects.length > 0 ? (
          <ul class="text-sm space-y-2 list-none p-0">
            {latestProjects.map((p) => (
              <li>
                <a
                  href={`/portfolio/${p.slug?.current ?? ''}`}
                  class="text-foreground/85 hover:text-link transition-colors"
                >
                  {p.title}
                </a>
              </li>
            ))}
            <li class="pt-xs">
              <a
                href="/portfolio"
                class="inline-flex items-center gap-xs text-xs uppercase tracking-eyebrow font-semibold text-link hover:text-primary-dark transition-colors"
              >
                View all <span aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
        ) : (
          <p class="text-sm text-foreground/85 italic">
            Case studies are coming soon. <a href="/portfolio" class="text-link hover:text-primary-dark underline underline-offset-2">See the portfolio →</a>
          </p>
        )}
      </nav>
    ) : (
      <div aria-hidden="true" />
    )}

    {/* GET IN TOUCH — email, phone, location, socials. */}
    <div>
      <p class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">
        Get in touch
      </p>
      <div class="text-sm space-y-1">
        {email && <p><CopyEmailButton client:visible email={email} variant="link" /></p>}
        {phone && (
          <p>
            <a
              href={telHref(phone)}
              class="inline-flex items-center gap-xs text-link hover:text-primary-dark transition-colors"
            >
              <Phone size={14} aria-hidden="true" />
              {phone}
            </a>
          </p>
        )}
      </div>
      <p class="mt-s text-sm text-foreground/75">
        {site.name}
      </p>
      {(ig || fb) && (
        <ul class="mt-m flex justify-center md:justify-start gap-s text-sm list-none p-0">
          {ig && (
            <li>
              <a
                href={ig}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground hover:bg-primary-dark hover:border-primary-dark hover:text-white transition-colors"
              >
                <IconBrandInstagram size={20} stroke={1.5} />
              </a>
            </li>
          )}
          {fb && (
            <li>
              <a
                href={fb}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
                class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground hover:bg-primary-dark hover:border-primary-dark hover:text-white transition-colors"
              >
                <IconBrandFacebook size={20} stroke={1.5} />
              </a>
            </li>
          )}
        </ul>
      )}
    </div>
  </div>

  {/* Logo + tagline — sits below the nav grid as a centered brand signature. */}
  <div class="mx-auto max-w-content px-m pb-l flex flex-col items-center gap-s text-center">
    <a
      href="/"
      aria-label={`${brandName} home`}
      class="inline-block hover:opacity-80 transition-opacity"
    >
      <img
        alt={brandName}
        width={96}
        height={102}
        class="h-20 w-auto"
        loading="lazy"
        decoding="async"
        data-theme-logo
        data-logo-light-src={footerLogoLight1x.src}
        data-logo-light-srcset={footerLogoLightSrcset}
        data-logo-dark-src={footerLogoDark1x.src}
        data-logo-dark-srcset={footerLogoDarkSrcset}
      />
    </a>
    {siteSettings?.tagline && (
      <p class="text-sm text-foreground/60 italic max-w-[28rem]">{siteSettings.tagline}</p>
    )}
  </div>

  {/* Thin bottom bar — copyright, privacy, optional "Site by..." credit on one
       line so they don't add a tall block to a footer column. */}
  <div class="border-t border-border">
    <div class="mx-auto max-w-content px-m py-m flex flex-col sm:flex-row items-center justify-center sm:justify-between gap-xs text-xs text-foreground/80 text-center">
      <p>© {currentYear} {brandName}</p>
      <div class="flex items-center gap-m">
        <a href="/privacy" class="underline underline-offset-2 hover:text-link transition-colors">
          Privacy policy
        </a>
        {siteCredit && (
          siteCreditUrl ? (
            <a
              href={siteCreditUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2 hover:text-link transition-colors"
            >
              {siteCredit}
            </a>
          ) : (
            <span>{siteCredit}</span>
          )
        )}
      </div>
    </div>
  </div>
</footer>
