---
// Foundation, edit with care
// Site header. Two structural rows on desktop, one on mobile:
//   ┌─────────────────────────────────────── 4px accent stripe
//   │ ─────────────────────────────────────── eyebrow strip (desktop-only)
//   │   [site tagline]           email  · IG · FB · theme
//   ├─────────────────────────────────────── main row
//   │   [logo]                  [nav]  │  [Book a consultation CTA]
//   └───────────────────────────────────────
// On mobile the eyebrow strip is hidden (its info lives in the MobileNav.astro
// drawer, a native <dialog>) and the main row centers the logo with the
// hamburger pinned absolute to the right. Once the page scrolls past 64px the
// bar compacts with transforms only (data-scrolled, script at the bottom).
//
// siteSettings is optional. Defaults render cleanly so the header works
// even before Sanity content is wired up.

import { getImage } from 'astro:assets';
import { site } from '@/data/site';
import { Mail, Phone } from 'lucide-react';
import { IconBrandInstagram, IconBrandFacebook } from '@tabler/icons-react';
import ThemeToggle from './ThemeToggle';
import MobileNav from './MobileNav.astro';
import { ChevronDown } from 'lucide-react';
import logoLightAsset from '@/assets/logo-light.svg';
import logoDarkAsset from '@/assets/logo-dark.svg';
import { resolveSiteSettings, type RawChromeSettings } from '@/lib/siteSettings';
import { telHref } from '@/lib/phone';
import { urlFor } from '@/lib/sanity';
import SearchButton from './search/SearchButton.astro';
import SiteSearch from './search/SiteSearch.astro';

// SVG logos are passed through Astro's image pipeline for cache-busted URLs.
// SVGs are resolution-independent so no 1x/2x variants are needed — one URL
// serves all pixel densities. The same URL is used for both desktop and mobile.
const logoLightImg = await getImage({ src: logoLightAsset });
const logoDarkImg = await getImage({ src: logoDarkAsset });
const logoLightSrcset = logoLightImg.src;
const logoDarkSrcset = logoDarkImg.src;

interface Props {
  siteSettings?:
    | (RawChromeSettings & {
        siteName?: string;
        title?: string;
        tagline?: string;
        email?: string;
        phone?: string;
        socialInstagram?: string;
        socialFacebook?: string;
        availabilityStatus?: string;
      })
    | null;
}

const { siteSettings } = Astro.props as Props;

const brandName = siteSettings?.siteName ?? siteSettings?.title ?? site.name;
const availability = siteSettings?.availabilityStatus ?? '';

// The chrome (menu, header button, logo, the show/hide switches) resolves
// through one shared helper (see src/lib/siteSettings.ts) so the header, the
// drawer, and the footer can never disagree about what the menu is.
const chrome = resolveSiteSettings(siteSettings);
const headerCta = chrome.headerCta;
const logo = chrome.logo;
// The logo box is 48px tall (h-12), so 280w covers a wide wordmark at 1x and
// 560w covers it at 2x. Built with urlFor() rather than <SanityImage> because
// the header renders on EVERY page: importing that component would pull its
// module into the always-loaded chunk and rename the site-wide CSS bundle.
const logoSrc = logo ? urlFor(logo).width(280).quality(80).auto('format').url() : undefined;
const logoSrcset = logo
  ? [280, 560]
      .map((w) => `${urlFor(logo).width(w).quality(80).auto('format').url()} ${w}w`)
      .join(', ')
  : undefined;

// Utility toggles (Site Settings -> Navigation). Both read "unset means yes",
// so an untouched site is unchanged. Turning one off is expressed by handing
// the markup an empty value rather than a new flag, which keeps the existing
// `{email && ...}` guards as the single place that decides.
const email = chrome.showEmail ? (siteSettings?.email ?? '') : '';
const phone = siteSettings?.phone ?? '';
const ig = chrome.showSocials ? (siteSettings?.socialInstagram ?? '') : '';
const fb = chrome.showSocials ? (siteSettings?.socialFacebook ?? '') : '';

// Subset of siteSettings the mobile menu needs.
const mobileNavSettings = siteSettings
  ? {
      tagline: siteSettings.tagline,
      email: chrome.showEmail ? siteSettings.email : undefined,
      phone: siteSettings.phone,
      socialInstagram: chrome.showSocials ? siteSettings.socialInstagram : undefined,
      socialFacebook: chrome.showSocials ? siteSettings.socialFacebook : undefined,
    }
  : null;

// Core nav structure. Flat items render as plain anchor links; dropdown
// items render as native <details>/<summary> disclosure groups on desktop
// (server-rendered, see the nav markup below) and as indented expandable
// groups in MobileNav.
//
// Why <details> and not a React island: the desktop nav must exist in the
// server-rendered HTML so search-engine crawlers see every internal link and
// so there is no flash-of-missing-nav (or CLS) before hydration. A native
// <details> disclosure is crawlable, keyboard-accessible, and works with zero
// JS. A tiny progressive-enhancement script (further down) adds the niceties
// browsers don't give us for free: open-on-hover, close-on-outside-click,
// close-on-Escape, and close-on-navigation. The links work without it.
//
// "Contact" is intentionally NOT in the primary nav — the "Book a consultation"
// CTA at the right of the nav row does that job, and the MobileNav drawer also
// surfaces the CTA at the top.
//
// Core nav: /, /about, /services, /faq, /journal, /contact (CTA button).
// /process is core too and is linked from the footer rather than the nav row.
// Module routes (/events, /resources) are opt-in via modules/ and are NOT
// linked from the core nav.

// The menu comes from Sanity (Site Settings -> Navigation). Both the mapping
// and the built-in safety-net menu live in src/lib/siteSettings.ts, so the
// header, the drawer, and the footer read one source. Empty in Sanity = the
// built-in menu, so a fresh clone is byte-identical to the old behavior.
const NAV_ITEMS = chrome.headerNav;

// MobileNav takes the same NavItem[] shape (flat links and dropdown groups).
const NAV_LINKS = NAV_ITEMS;

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href.endsWith('/') ? href : `${href}/`);
}
// A dropdown group is "active" (its trigger underline locks wide + aria-current
// is set) when the current route matches any of its child links.
function isGroupActive(items: { href: string }[]) {
  return items.some((item) => isActive(item.href));
}
---

<header class="site-header bg-background">
  {/* Brand accent stripe — same visual signature used at the top of the
      mobile menu drawer. Visible on every viewport. */}
  <div class="h-1 bg-primary" aria-hidden="true"></div>

  {/* Eyebrow strip (desktop only). Carries the locked positioning line and
      utility controls (email + social icons + theme toggle). Mobile gets
      the same info through the MobileNav drawer. Breakpoint bumped from
      md (768 px) to lg (1024 px) so the eyebrow strip + nav row only
      appear once there's room for the full nav + CTA without squishing
      the logo. */}
  <div class="site-header__eyebrow hidden border-b border-border-soft bg-muted lg:block">
    <div class="mx-auto flex max-w-content items-center justify-between px-l py-2">
      <div class="flex items-center gap-m">
        <p class="text-xs tracking-eyebrow text-foreground/80 uppercase">
          {siteSettings?.tagline ?? site.name}
        </p>
        {/* Availability status, mirroring the mobile pill. Same pulsing dot
            and link to /contact, so the trust signal is consistent at every
            width (compact "Open" on phones, full status from md up). */}
        {availability && (
          <>
            <span class="h-3 w-px bg-border-soft" aria-hidden="true" />
            <a
              href="/contact/"
              class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-eyebrow text-foreground uppercase transition-colors hover:text-link"
              aria-label={`${availability}. Get in touch.`}
            >
              <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-tertiary opacity-60" />
                <span class="relative inline-flex h-2 w-2 rounded-full bg-tertiary" />
              </span>
              {availability}
            </a>
          </>
        )}
      </div>
      <div class="flex items-center gap-m">
        {email && (
          <a
            href={`mailto:${email}`}
            class="inline-flex items-center gap-xs text-xs text-foreground transition-colors hover:text-link"
          >
            <Mail size={12} aria-hidden="true" />
            {email}
          </a>
        )}
        {phone && (
          <a
            href={telHref(phone)}
            class="inline-flex items-center gap-xs text-xs text-foreground transition-colors hover:text-link"
          >
            <Phone size={12} aria-hidden="true" />
            {phone}
          </a>
        )}
        {(ig || fb) && (
          <div class="flex items-center gap-1">
            {ig && (
              <a
                href={ig}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                class="inline-flex h-7 w-7 items-center justify-center rounded-full text-foreground transition-colors hover:bg-accent hover:text-link"
              >
                <IconBrandInstagram size={14} stroke={1.5} />
              </a>
            )}
            {fb && (
              <a
                href={fb}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
                class="inline-flex h-7 w-7 items-center justify-center rounded-full text-foreground transition-colors hover:bg-accent hover:text-link"
              >
                <IconBrandFacebook size={14} stroke={1.5} />
              </a>
            )}
          </div>
        )}
        {/* Hydrate when idle, not on load — the anti-FOUC inline script in
            BaseLayout already applies the correct theme class before first
            paint, so this React island only needs to be live by the time the
            visitor moves to click it. Demoting from client:load shaves real
            TBT off mobile Lighthouse runs. */}
        <ThemeToggle client:idle />
      </div>
    </div>
  </div>

  {/* Main nav row. Mobile (and tablet) center the logo; desktop ≥1024 px
      justifies logo left, nav+CTA grouped right. Breakpoint matches the
      eyebrow strip above — at viewports between md and lg the desktop
      layout would squish, so mobile-style header stays in use. */}
  <div class="site-header__row relative mx-auto flex max-w-content items-center justify-center border-b border-border px-l py-m lg:justify-between">
    {/* Mobile-only availability pill, mirroring the hamburger menu's
        absolute-right placement. Gives mobile visitors an at-a-glance trust
        signal ("Open / accepting new clients") and a single-tap path to
        /contact — meaningfully conversion-positive in a tiny footprint. Renders
        nothing when siteSettings.availabilityStatus is empty so the slot just
        stays empty negative space. */}
    {availability && (
      <a
        href="/contact/"
        class="site-header__pill absolute top-1/2 left-m inline-flex h-9 -translate-y-1/2 items-center gap-1.5 rounded-full border border-border-soft bg-muted pr-2.5 pl-2 text-foreground transition-colors hover:border-primary hover:text-primary-dark lg:hidden"
        aria-label={`${availability}. Tap to start a conversation.`}
      >
        <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
          {/* Soft pulsing halo — kills under prefers-reduced-motion via the
              global rule that flattens all animations. */}
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-tertiary opacity-60" />
          <span class="relative inline-flex h-2 w-2 rounded-full bg-tertiary" />
        </span>
        {/* On the narrowest phones the centered logo leaves room only for a
            compact "Open". From md up, where the pill has space before the
            logo, show the full availabilityStatus so the roomy header doesn't
            read as half-empty. The complete status is always in the aria-label
            and on the Contact page. */}
        <span class="text-xs font-semibold tracking-eyebrow whitespace-nowrap uppercase md:hidden">
          Open
        </span>
        <span class="hidden text-xs font-semibold tracking-eyebrow whitespace-nowrap uppercase md:inline">
          {availability}
        </span>
      </a>
    )}

    <a
      href="/"
      class="site-header__logo inline-flex items-center transition-opacity hover:opacity-80"
      aria-label={`${brandName} home`}
    >
      {/*
        Single theme-aware logo. The img ships with NO src/srcset so the
        browser doesn't start fetching anything; the inline script below
        sets the right variant synchronously before paint based on the
        current html.dark state, then re-applies on theme-toggle and
        astro:after-swap (handled in the anti-FOUC script in BaseLayout).
        Net result: only one logo file is ever fetched per page load, and
        Lighthouse no longer sees a dark-variant in light-mode DOM (or
        vice-versa).

        Dimensions and aspect ratio (100×106) match the source 378:400,
        so the browser reserves the right layout box before the file lands
        — no CLS.
      */}
      {logo ? (
        /* An uploaded Site Settings logo replaces the pair above. It carries no
           data-theme-logo attribute, so the inline swap script below skips it
           and the one image serves both themes. */
        <img
          src={logoSrc}
          srcset={logoSrcset}
          sizes="280px"
          alt={logo.alt || brandName}
          class="h-12 w-auto"
          loading="eager"
          decoding="async"
        />
      ) : (
        <img
          alt={brandName}
          width={280}
          height={60}
          class="h-12 w-auto"
          loading="eager"
          decoding="async"
          data-theme-logo
          data-logo-light-src={logoLightImg.src}
          data-logo-light-srcset={logoLightSrcset}
          data-logo-dark-src={logoDarkImg.src}
          data-logo-dark-srcset={logoDarkSrcset}
        />
      )}
      {/* No-JS fallback (card 108). The swap img above has no src until the
          inline script runs, so with JS off it would show only its alt text.
          The noscript copy carries the light variant (no-JS never gets
          html.dark) and the scoped rule below hides the src-less swap img.
          A noscript img is not fetched when JS is on, so the single-fetch
          behaviour is unchanged. */}
      {!logo && (
        <noscript>
          <img
            src={logoLightImg.src}
            alt={brandName}
            width={280}
            height={60}
            class="h-12 w-auto"
            decoding="async"
          />
        </noscript>
      )}
    </a>
    {/* Synchronous inline setup — runs immediately after the img element
        is parsed, so the src is set before the browser begins any image
        fetch. Re-applied across View Transitions navs by the anti-FOUC
        listener in BaseLayout. */}
    <script is:inline>
      (function () {
        const img = document.querySelector('header img[data-theme-logo]');
        if (!img) return;
        const dark = document.documentElement.classList.contains('dark');
        img.src = dark ? img.dataset.logoDarkSrc : img.dataset.logoLightSrc;
        img.srcset = dark ? img.dataset.logoDarkSrcset : img.dataset.logoLightSrcset;
      })();
    </script>
    {/* Nav + CTA grouped on the right (lg+ only).

        The desktop nav is server-rendered as real <a> tags (flat links) plus
        native <details> disclosure groups (the two dropdowns). Everything is in
        the HTML at build time — crawlable, keyboard-usable, and present before
        any JS runs (no flash, no CLS). The progressive-enhancement script at the
        bottom of this file layers on hover-to-open + outside-click/Escape/
        navigation close; the nav is fully functional without it. */}
    <div class="site-header__nav hidden items-center gap-l lg:flex">
      <nav class="site-nav flex items-center gap-l" aria-label="Primary">
        {NAV_ITEMS.map((item) =>
          item.kind === 'flat' ? (
            <a
              href={item.href}
              class:list={[
                'nav-underline text-sm tracking-wide transition-colors',
                isActive(item.href) ? 'font-semibold text-link' : 'text-foreground hover:text-link',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ) : (
            <details class="site-nav__group relative">
              {/* <summary> is the disclosure toggle. It carries .nav-underline
                  so it gets the same bronze underline as flat links, and
                  aria-current="page" (which locks the underline wide) when one
                  of its children is the active route. role/aria-expanded are
                  managed natively by <details>. */}
              <summary
                class:list={[
                  'nav-underline text-sm tracking-wide transition-colors',
                  'inline-flex cursor-pointer list-none items-center gap-0.5 select-none',
                  'rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2',
                  isGroupActive(item.items)
                    ? 'font-semibold text-link'
                    : 'text-foreground hover:text-link',
                ]}
                aria-current={isGroupActive(item.items) ? 'page' : undefined}
              >
                {item.label}
                <ChevronDown
                  size={14}
                  className="site-nav__chevron mt-px transition-transform duration-150"
                  aria-hidden="true"
                />
              </summary>

              {/* Menu panel. Absolutely positioned under the summary so it
                  doesn't shift layout. Uses popover tokens to match the mobile
                  drawer + shadcn dropdowns, and the bronze ring + shadow of the
                  card rhythm. */}
              <div class="site-nav__menu absolute top-full left-0 z-50 mt-2 min-w-[200px] rounded-lg bg-popover p-1 text-popover-foreground shadow-md ring-1 ring-foreground/10">
                {item.items.map((sub) => (
                  <a
                    href={sub.href}
                    class:list={[
                      'block rounded-md px-2.5 py-1.5 text-sm transition-colors',
                      'outline-none hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground',
                      isActive(sub.href) ? 'font-semibold text-link' : 'text-foreground',
                    ]}
                    aria-current={isActive(sub.href) ? 'page' : undefined}
                  >
                    {sub.label}
                  </a>
                ))}
              </div>
            </details>
          ),
        )}
      </nav>
      {/* Visitor search (card 126). Renders nothing when search is off. */}
      <SearchButton class="inline-flex h-9 w-9 items-center justify-center rounded-md text-foreground transition-colors hover:bg-accent hover:text-link focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none" />
      <span class="h-6 w-px bg-border-soft" aria-hidden="true"></span>
      {headerCta.show && (
        <a
          href={headerCta.href}
          class:list={[
            'press-tactile inline-flex items-center rounded-md px-m py-2 text-xs font-semibold tracking-eyebrow uppercase',
            isActive(headerCta.href)
              ? 'bg-accent-dark text-white'
              : 'bg-primary-dark text-white hover:bg-accent-dark',
          ]}
        >
          {headerCta.label}
        </a>
      )}
    </div>

    {/* The phone menu is server markup on a native <dialog> (MobileNav.astro,
        card 157): no React island, the hamburger and every link are in the
        server HTML. See docs/agent/components.md. */}
    {/* Mobile search button, just left of the hamburger (card 126). */}
    <SearchButton class="absolute top-1/2 right-[calc(var(--spacing-m)+2.75rem)] inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-md text-foreground transition-colors hover:bg-accent lg:hidden" />

    <MobileNav
      search={site.search.enabled}
      links={NAV_LINKS}
      siteSettings={mobileNavSettings}
      logoLightUrl={logoLightImg.src}
      logoDarkUrl={logoDarkImg.src}
      brandName={brandName}
      cta={headerCta}
    />
  </div>
  {site.search.enabled && <SiteSearch />}
</header>

<style>
  /* The theme-aware logo only lacks a src when the inline swap script never
     ran (JS off); the <noscript> copy shows instead (card 108). */
  img[data-theme-logo]:not([src]) {
    display: none;
  }

  /* Desktop dropdown groups (native <details>). The links are server-rendered
     and fully usable with no JS; these styles + the script below add the
     dropdown affordances. */

  /* Hide the default disclosure triangle in every engine. */
  .site-nav__group > summary {
    list-style: none;
  }
  .site-nav__group > summary::-webkit-details-marker,
  .site-nav__group > summary::marker {
    display: none;
    content: '';
  }

  /* Rotate the chevron when the group is open. */
  .site-nav__group[open] > summary .site-nav__chevron {
    transform: rotate(180deg);
  }

  /* The menu panel starts hidden until the <details> is open. <details>
     natively hides non-summary children when closed, but we keep an explicit
     rule so the absolutely-positioned panel never flashes during hydration. */
  .site-nav__menu {
    display: none;
  }
  .site-nav__group[open] > .site-nav__menu {
    display: block;
  }
</style>

{/* Progressive enhancement for the desktop dropdown nav. Everything still
    works without this (native <details> toggles on click/Enter/Space, links
    are real <a> tags). This adds one dropdown model (card 157): open-on-hover
    for a mouse with a 300ms close delay (a click on a label hover has opened
    keeps it open), close-on-outside-click, close-on-Escape with focus back on
    the label, and close-when-a-link-is-followed.
    Re-binds on astro:page-load so it survives View Transitions navigations. */}
<script>
  // Query groups fresh each call — the nav DOM is replaced on every View
  // Transitions navigation, so a captured list would go stale.
  function currentGroups() {
    return Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-nav__group'));
  }

  function closeAllGroups(except?: HTMLDetailsElement) {
    for (const g of currentGroups()) {
      if (g !== except) g.open = false;
    }
  }

  function initHeaderNav() {
    const groups = currentGroups();
    if (groups.length === 0) return;

    const closeAll = closeAllGroups;

    for (const group of groups) {
      const summary = group.querySelector('summary');
      let closeTimer: number | undefined;

      const cancelClose = () => {
        if (closeTimer) {
          window.clearTimeout(closeTimer);
          closeTimer = undefined;
        }
      };

      // One model, so hover and click never fight (card 157). A mouse opens a
      // group by hovering, and it stays open while the pointer is over the
      // label or the panel. Clicking the label of a group hover has just opened
      // keeps it open (it used to toggle the <details> shut under the cursor);
      // a second click closes it. Leaving starts a 300ms close, long enough for
      // a diagonal path from the label to a link, cancelled the moment the
      // pointer comes back. Touch and keyboard skip all of this: a tap, Enter
      // or Space toggles the native <details>.
      let openedByHover = false;
      group.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        if (group.open) return;
        closeAll(group);
        group.open = true;
        openedByHover = true;
      });
      group.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'touch') return;
        cancelClose();
        closeTimer = window.setTimeout(() => {
          group.open = false;
          openedByHover = false;
        }, 300);
      });

      summary?.addEventListener('click', (e) => {
        // A mouse click on a label hover has already opened: keep it open, once.
        // (e.detail is 0 for Enter or Space, so the keyboard always toggles.)
        if (group.open && openedByHover && e.detail > 0) {
          e.preventDefault();
          openedByHover = false;
          return;
        }
        openedByHover = false;
        // <details> toggles AFTER this handler, so the post-toggle state is the
        // inverse of the current one. If it's about to open, close the rest.
        if (!group.open) closeAll(group);
      });

      // Following a link inside the menu should close the group (so it isn't
      // left open behind the next page during a View Transitions swap).
      group.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          group.open = false;
        });
      });
    }
  }

  // Document-level listeners bind ONCE (guarded by a window flag), so they
  // don't stack up across View Transitions navigations. They query the nav
  // groups fresh each time they fire, so the swapped-in DOM is always covered.
  const w = window as typeof window & { __headerNavBound?: boolean };
  if (!w.__headerNavBound) {
    w.__headerNavBound = true;

    // Close any open group when clicking outside the nav.
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node;
      if (!currentGroups().some((g) => g.contains(target))) closeAllGroups();
    });

    // Escape closes the open group and returns focus to its summary.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const openGroup = currentGroups().find((g) => g.open);
      if (openGroup) {
        openGroup.open = false;
        openGroup.querySelector('summary')?.focus();
      }
    });
  }

  initHeaderNav();
  document.addEventListener('astro:page-load', initHeaderNav);
</script>

{/* Header compaction (card 157). data-scrolled: the page has moved, so the bar
    compacts. From lg up the accent stripe and eyebrow strip slide up out of
    view and the main row tightens, all with transforms (globals.css, "Header
    compaction"), so the bar keeps its layout height and nothing under it
    reflows. Two thresholds, not one: it compacts past 64px and opens again only
    at 8px or less, so a small scroll jitter near the top (or the browser's
    scroll anchoring) cannot flip it every few frames and shake the bar. The
    global reduced-motion reset makes the change instant. */}
<script>
  const COMPACT_AT = 64;
  const OPEN_AT = 8;

  // How far the bar slides up when compact: the stripe plus the eyebrow strip
  // (0 below lg, where the strip is display:none). Measured, not hard-coded,
  // so a taller eyebrow (a long tagline, a phone number) still clears fully.
  const measureHeader = () => {
    const header = document.querySelector<HTMLElement>('.site-header');
    const row = header?.querySelector<HTMLElement>('.site-header__row');
    if (!header || !row) return;
    header.style.setProperty('--hdr-top', `${row.offsetTop}px`);
  };

  const updateHeaderState = () => {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    const y = window.scrollY;
    if (y > COMPACT_AT) header.setAttribute('data-scrolled', '');
    else if (y <= OPEN_AT) header.removeAttribute('data-scrolled');
  };

  const hw = window as typeof window & { __headerStateBound?: boolean };
  if (!hw.__headerStateBound) {
    hw.__headerStateBound = true;
    let queued = false;
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          updateHeaderState();
        });
      },
      { passive: true },
    );
    window.addEventListener(
      'resize',
      () => {
        measureHeader();
        updateHeaderState();
      },
      { passive: true },
    );
    document.addEventListener('astro:page-load', () => {
      measureHeader();
      updateHeaderState();
    });
  }
  measureHeader();
  updateHeaderState();
</script>
