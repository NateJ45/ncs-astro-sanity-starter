---
// Safe to edit by hand
// The eyebrow + headline pairing used at the top of nearly every section.
// Pass `headingId` so the parent <section> can use aria-labelledby={headingId}
// for an accessible name (per CLAUDE.md a11y guidance).
//
// Variants:
//   - level: which heading tag (h1 for hero, h2 for sections, h3 for sub-sections). Default h2.
//   - align: "left" (default) or "center" for centered section heads
//   - tone: "default" (foreground on light surfaces) or "inverse" (bg/light on dark CTA banners)
//
// Script accent:
//   - scriptAccent?: optional single word/phrase from the headline to render
//     in the script accent font via the `.font-script` utility. The first occurrence is
//     wrapped. Falls back to plain rendering when undefined, empty, or not
//     found — so no existing heading is affected unless the prop is explicitly
//     passed with a matching string.
//   - Logic is shared with Hero.astro via splitScriptAccent() in src/lib/scriptAccent.ts.
//   - At most one script accent per heading (editorial discipline, per CLAUDE.md).
//
// Heading accent (PORTS.md card 26, 2026-08-28):
//   - headingAccent?: the COLOUR sibling of the script accent. Same idea, same
//     one-per-heading rule: an editor types a word that already appears in the
//     headline and the first match is wrapped in `.heading-accent`, which reads
//     the brand accent colour (globals.css; measured on every surface in both
//     themes by src/lib/surfaces.test.ts). Matching is case-insensitive and
//     stega-safe, unlike splitScriptAccent - see src/lib/heading-accent.ts.
//   - PRECEDENCE, and it is deliberate: if a script accent is set AND found,
//     the colour accent is skipped. Two accents on one heading is decoration,
//     not emphasis, and the script accent is the older, louder device.
//   - Unset or not found, `headline` renders exactly the string it always did.
//
// Rich subhead (same card):
//   - subheadRich?: the optional portable-text twin of `subhead`, allowing bold
//     and italic and nothing else (src/lib/inline-rich.ts). When it holds text
//     it is rendered INSIDE the same <p> with the same classes, so the only
//     difference in the markup is the <strong> / <em> the editor asked for.
//     Empty or absent, the plain `subhead` renders untouched.

import { splitScriptAccent } from '@/lib/scriptAccent';
import { splitHeadingAccent } from '@/lib/heading-accent';
import { hasInlineRich } from '@/lib/inline-rich';
import InlineRich from '@/components/InlineRich.astro';

interface Props {
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  /** Optional rich twin of `subhead`: bold and italic only. */
  subheadRich?: unknown;
  headingId: string;
  level?: 'h1' | 'h2' | 'h3';
  align?: 'left' | 'center';
  tone?: 'default' | 'inverse';
  /**
   * Optional single word/phrase from the headline to render in handwritten
   * the script accent font. Must match the headline text exactly (case-sensitive).
   * Leave undefined or blank to skip. Use sparingly — one accent per heading.
   */
  scriptAccent?: string;
  /**
   * Optional single word/phrase from the headline to set in the brand accent
   * colour. Case-insensitive, first match only. Ignored when a script accent is
   * already in play: one accent per heading.
   */
  headingAccent?: string;
  class?: string;
}

const {
  eyebrow,
  headline,
  subhead,
  subheadRich,
  headingId,
  level = 'h2',
  align = 'left',
  tone = 'default',
  scriptAccent,
  headingAccent,
  class: extraClass = '',
} = Astro.props as Props;

// Split the headline around the script-accent word when provided.
// When not found or not set, `found` is false and we render `headline` plain.
const { found: scriptFound, before: scriptBefore, word: scriptWord, after: scriptAfter } =
  splitScriptAccent(headline ?? '', scriptAccent);

// The colour accent, only considered when the script accent did not fire.
const colour = scriptFound
  ? { found: false, before: '', word: '', after: '', heading: headline ?? '' }
  : splitHeadingAccent(headline, headingAccent);

const richSubhead = hasInlineRich(subheadRich);

const headingClass =
  level === 'h1'
    ? 'font-display text-h1 leading-headline-tight tracking-[-0.02em]'
    : level === 'h2'
    ? 'font-display text-h2 leading-tight'
    : 'font-display text-h3 leading-tight';

const wrapperAlign = align === 'center' ? 'text-center mx-auto' : 'text-left';
const toneHeadline = tone === 'inverse' ? 'text-bg' : 'text-foreground';
// Default tone swapped from text-secondary (Warm Taupe, fails AA at 12px) to
// text-foreground/80 (4.77:1 on Cream). Inverse tone (used on FinalCta's
// dark Charcoal panel) keeps cream-on-dark.
const toneEyebrow = tone === 'inverse' ? 'text-bg/75' : 'text-foreground/80';
const toneSub = tone === 'inverse' ? 'text-bg/80' : 'text-foreground/80';

// Bronze hairline accent beneath the eyebrow. Matches the brand-stripe
// signature now repeating on every marketing card so section headings read
// with the same editorial vocabulary. On inverse tone (dark FinalCta panel)
// the hairline switches to lifted cream so it stays visible.
const accentColor = tone === 'inverse' ? 'bg-bg/40' : 'bg-primary/60';
const accentAlign = align === 'center' ? 'mx-auto' : '';
---

<div class:list={[wrapperAlign, 'max-w-3xl', extraClass]}>
  {eyebrow && (
    <>
      <p class:list={['text-xs uppercase tracking-eyebrow', toneEyebrow]}>{eyebrow}</p>
      <div
        class:list={['mt-s mb-m h-px w-12', accentAlign, accentColor]}
        aria-hidden="true"
      ></div>
    </>
  )}
  {headline && (
    level === 'h1' ? (
      <h1 id={headingId} class:list={[headingClass, toneHeadline]}>
        {scriptFound
          ? <>{scriptBefore}<span class="font-script">{scriptWord}</span>{scriptAfter}</>
          : colour.found
          ? <>{colour.before}<span class="heading-accent">{colour.word}</span>{colour.after}</>
          : headline}
      </h1>
    ) : level === 'h2' ? (
      <h2 id={headingId} class:list={[headingClass, toneHeadline]}>
        {scriptFound
          ? <>{scriptBefore}<span class="font-script">{scriptWord}</span>{scriptAfter}</>
          : colour.found
          ? <>{colour.before}<span class="heading-accent">{colour.word}</span>{colour.after}</>
          : headline}
      </h2>
    ) : (
      <h3 id={headingId} class:list={[headingClass, toneHeadline]}>
        {scriptFound
          ? <>{scriptBefore}<span class="font-script">{scriptWord}</span>{scriptAfter}</>
          : colour.found
          ? <>{colour.before}<span class="heading-accent">{colour.word}</span>{colour.after}</>
          : headline}
      </h3>
    )
  )}
  {(subhead || richSubhead) && (
    <p class:list={['mt-m text-lg', toneSub]}>
      {richSubhead ? <InlineRich value={subheadRich} /> : subhead}
    </p>
  )}
</div>
