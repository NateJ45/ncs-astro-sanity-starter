---
// Page-builder block: a centered pull quote / testimonial. Surface comes from
// SectionRenderer. Safe to edit by hand.
import { surfaceClass, type CadenceSurface } from '@/lib/surfaces';

interface Props {
  quote?: string;
  attribution?: string;
  detail?: string;
  /** From SectionRenderer's cadence, including the band an editor's look asks for. */
  surface?: CadenceSurface;
}

const { quote, attribution, detail, surface = 'background' } = Astro.props as Props;
// Surface classes come from src/lib/surfaces.ts (the measured pairs). Same
// strings as the ternary that was here for 'background' and 'muted'.
const bg = surfaceClass(surface);
---

{quote && (
  <section class:list={['surface-warm', bg]}>
    <div class="mx-auto max-w-content px-m py-section-lg text-center" data-reveal>
      <span class="font-display text-2xl tracking-[0.6em] text-link select-none" aria-hidden="true">
        ✺
      </span>
      <blockquote class="mx-auto mt-m max-w-3xl font-display text-h3 leading-snug text-foreground italic md:text-h2">
        {quote}
      </blockquote>
      {(attribution || detail) && (
        <p class="mt-l text-sm tracking-eyebrow text-foreground/80 uppercase">
          {attribution}
          {attribution && detail ? ' · ' : ''}
          {detail}
        </p>
      )}
    </div>
  </section>
)}
