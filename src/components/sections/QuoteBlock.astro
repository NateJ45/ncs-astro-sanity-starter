---
// Page-builder block: a centered pull quote / testimonial. Surface comes from
// SectionRenderer. Safe to edit by hand.
interface Props {
  quote?: string;
  attribution?: string;
  detail?: string;
  surface?: 'background' | 'muted';
}

const { quote, attribution, detail, surface = 'background' } = Astro.props as Props;
const bg = surface === 'muted' ? 'bg-muted' : 'bg-background';
---

{
  quote && (
    <section class:list={['surface-warm', bg]}>
      <div class="mx-auto max-w-content px-m py-section-lg text-center" data-reveal>
        <span
          class="font-display text-2xl tracking-[0.6em] text-link select-none"
          aria-hidden="true"
        >
          ✺
        </span>
        <blockquote class="mx-auto mt-m max-w-3xl font-display text-h3 leading-snug text-foreground italic md:text-h2">
          {quote}
        </blockquote>
        {(attribution || detail) && (
          <p class="mt-l text-sm tracking-eyebrow text-foreground/80 uppercase">
            {attribution}
            {attribution && detail ? ' · ' : ''}
            {detail}
          </p>
        )}
      </div>
    </section>
  )
}
