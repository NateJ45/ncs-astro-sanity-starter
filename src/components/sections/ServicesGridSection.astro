---
// Foundation, edit with care
// Services grid/list section. 'grid' variant: up to 4 compact cards (home).
// 'list' variant: full anchor-linkable service cards (services page).
// Manages its own surface-warm bg-background (SELF_CONTAINED — no surface prop).
// Services are resolved at query time by sectionsProjection() and passed in.
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CtaLink from '@/components/CtaLink.astro';

interface Props {
  eyebrow?: string;
  headline?: string;
  scriptAccent?: string;
  /** One word of the headline in the brand accent colour. See SectionHeading. */
  headingAccent?: string;
  subhead?: string;
  /** Optional rich twin of `subhead`: bold and italic only. */
  subheadRich?: unknown;
  services?: any[];
  cta?: any;
  footnote?: string;
  variant?: 'grid' | 'list';
  headingId?: string;
}

const {
  eyebrow = 'Our Services.',
  headline = 'Find the right fit for your project.',
  scriptAccent,
  headingAccent,
  subhead,
  subheadRich,
  services = [],
  cta,
  footnote,
  variant = 'grid',
  headingId = 'services-grid-heading',
} = Astro.props as Props;

const isGrid = variant === 'grid';
---

<section class="surface-warm bg-background" aria-labelledby={headingId}>
  <div class={`${isGrid ? '' : ''} mx-auto max-w-content px-m py-section-lg`} data-reveal>
    <SectionHeading
      eyebrow={eyebrow}
      headline={headline}
      subhead={subhead}
      subheadRich={subheadRich}
      headingId={headingId}
      align="center"
      class="mx-auto"
      scriptAccent={scriptAccent}
      headingAccent={headingAccent}
    />

    {
      isGrid ? (
        <>
          {services.length > 0 && (
            <div
              class="mt-section-lg grid grid-cols-1 gap-m md:grid-cols-2 lg:grid-cols-4"
              data-stagger-grid
            >
              {services.slice(0, 4).map((service: any) => (
                <ServiceCard service={service} compact={true} />
              ))}
            </div>
          )}
          <div class="mt-section-lg flex justify-center">
            <CtaLink
              cta={cta}
              variant="secondary"
              fallbackHref="/services"
              fallbackLabel="See All Services"
            />
          </div>
        </>
      ) : (
        <>
          {services.length >= 3 && (
            <nav class="mt-m flex flex-col items-center gap-s" aria-label="On this page">
              <p class="text-xs tracking-eyebrow text-foreground/80 uppercase">On this page</p>
              <ul class="flex list-none flex-wrap justify-center gap-xs p-0">
                {services.map((service: any) =>
                  service.slug?.current ? (
                    <li>
                      <a
                        href={`#${service.slug.current}`}
                        class="press-tactile inline-flex min-h-[36px] items-center rounded-full border border-border-soft px-s py-1.5 text-xs tracking-eyebrow text-foreground/85 uppercase transition-colors hover:border-primary hover:text-link"
                      >
                        {service.name}
                      </a>
                    </li>
                  ) : null,
                )}
              </ul>
            </nav>
          )}
          {services.length > 0 ? (
            <div
              class="mt-section-lg grid grid-cols-1 gap-l md:grid-cols-2 lg:grid-cols-3"
              data-stagger-grid
            >
              {services.map((service: any) => (
                <ServiceCard service={service} withAnchor={true} />
              ))}
            </div>
          ) : (
            <p class="mt-section-lg text-center text-muted-foreground italic">
              Services are being updated.{' '}
              <a href="/contact" class="text-link underline underline-offset-2">
                Get in touch
              </a>{' '}
              and we will talk through what you need.
            </p>
          )}
        </>
      )
    }

    {
      footnote && (
        <p class="mt-section-md text-center text-sm text-muted-foreground italic">{footnote}</p>
      )
    }
  </div>
</section>
