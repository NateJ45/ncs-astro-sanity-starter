---
// Safe to edit by hand
// Page-builder block: "Custom code or embed" (PORTS.md card 121).
// Three ways in, decided by the fields:
//   embedUrl                 a provider's page in a sandboxed iframe (Calendly,
//                            Cal.com, Tally, Google Forms). Unchanged.
//   embedCode                pasted HTML/CSS/JS in its OWN BOX: CustomCodeFrame,
//                            an srcdoc iframe with no allow-same-origin, so it
//                            cannot read the site's cookies, storage or page.
//                            Sizes itself to its content. The default.
//   embedCode + runsOnPage   the old behaviour, set:html straight into the page,
//                            for trusted provider snippets that need the page
//                            itself. Listed by the Checkup ("Code that runs
//                            directly on the page").
// Trust model in full: docs/agent/custom-code.md.
//
// Paste-and-go (PORTS.md card 172, src/lib/embed-providers.ts): what was pasted
// is read against a registry of known services. A YouTube, Spotify or Maps link
// (or their iframe embed code) becomes the service's own player at the right
// shape; a known service's script code may run on the page; code that runs
// scripts from an UNKNOWN service never runs on the page, even with the switch
// on: it is shown in its own box instead (the Studio says who must approve it;
// a site approves a one-off origin in site.embeds.approvedScriptOrigins). The
// registry's id is written on the wrapper as data-embed-provider, and
// scripts/build-csp.mjs adds that service's script origins to the security
// policy of the build that uses it.
//
// SELF_CONTAINED — manages its own bg-background surface (no surface prop).
import SectionHeading from '@/components/SectionHeading.astro';
import CustomCodeFrame from '@/components/CustomCodeFrame.astro';
import { stegaClean } from '@sanity/client/stega';
import { planEmbed, type EmbedPlan } from '@/lib/embed-providers';
import { site } from '@/data/site';

interface Props {
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  embedUrl?: string;
  embedCode?: string;
  /** Run embedCode directly on the page instead of in its own box. Off by default. */
  runsOnPage?: boolean;
  heightHint?: 'short' | 'medium' | 'tall';
  headingId?: string;
  /** Repo-written code (the styleguide's probes): may run on the page as written. */
  trustedCode?: boolean;
}

const {
  eyebrow,
  headline,
  subhead,
  embedUrl,
  embedCode,
  runsOnPage = false,
  heightHint = 'medium',
  headingId = 'embed-section-heading',
  trustedCode = false,
} = Astro.props as Props;

// The preview stega-encodes strings; the plan must read what was pasted.
const planned = planEmbed(
  {
    embedUrl: embedUrl ? stegaClean(embedUrl) : undefined,
    embedCode: embedCode ? stegaClean(embedCode) : undefined,
    runsOnPage,
  },
  site.embeds.approvedScriptOrigins,
);
// Repo-written probes skip the approval guard; nothing from Sanity reaches this.
const plan =
  trustedCode && planned.kind === 'box' && planned.blocked
    ? ({ kind: 'page', provider: undefined } as EmbedPlan)
    : planned;
// A link that cannot be framed (a Maps share link, say) shows nothing on the
// website; the Studio explains what to paste instead.
const hasContent = plan.kind !== 'none' && plan.kind !== 'problem';
// Boxed custom code sizes itself, so the wrapper must not hold the min-height.
const boxedCode = plan.kind === 'box';
// A known service's player sizes itself from the registry.
const sized = plan.kind === 'frame' && Boolean(plan.aspect || plan.height);
const frameStyle =
  plan.kind === 'frame' && plan.aspect
    ? `aspect-ratio: ${plan.aspect}`
    : plan.kind === 'frame' && plan.height
      ? `height: ${plan.height}px`
      : undefined;
// Only code runs under this page's policy (a framed page has its own), so only
// code carries the marker build-csp.mjs reads.
const providerId = plan.kind === 'box' || plan.kind === 'page' ? plan.provider?.id : undefined;
const hasHeading = !!(eyebrow || headline);

// Map height hint to sensible min-height values.
const minHeightClass =
  heightHint === 'short'
    ? 'min-h-[400px]'
    : heightHint === 'tall'
      ? 'min-h-[900px]'
      : 'min-h-[640px]';
// The space boxed code holds while it loads (and keeps without JavaScript).
const initialHeight = heightHint === 'short' ? 240 : heightHint === 'tall' ? 640 : 400;

// Sandbox policy: allow forms + scripts for widgets like Tally, Calendly, Cal.
// allow-same-origin is required for Calendly to post messages to parent window.
// A known service (giving, booking) may open its checkout in a normal new tab.
const sandbox =
  'allow-scripts allow-forms allow-same-origin allow-popups' +
  (plan.kind === 'frame' && plan.provider ? ' allow-popups-to-escape-sandbox' : '');
const iframeTitle = headline || eyebrow || 'Embedded content';
---

{hasContent && (
  <section
    class="bg-background"
    aria-labelledby={hasHeading ? headingId : undefined}
    aria-label={!hasHeading ? 'Embedded content' : undefined}
  >
    <div class="mx-auto max-w-content px-m py-section-lg" data-reveal>
      {hasHeading && (
        <SectionHeading
          eyebrow={eyebrow}
          headline={headline}
          subhead={subhead}
          headingId={headingId}
          align="center"
          class="mx-auto"
        />
      )}

      <div
        class:list={[
          'w-full',
          !boxedCode && !sized && minHeightClass,
          hasHeading && 'mt-section-md',
        ]}
        data-embed-provider={providerId}
      >
        {plan.kind === 'frame' ? (
          /* A provider's page or player, or an unknown service: sandboxed iframe */
          <iframe
            src={plan.src}
            title={iframeTitle}
            sandbox={sandbox}
            allow={plan.allow}
            loading="lazy"
            class:list={['w-full border-0', !sized && minHeightClass]}
            style={frameStyle}
            allowfullscreen
          />
        ) : boxedCode ? (
          /* Pasted code in its own box (the default). */
          <CustomCodeFrame code={embedCode!} title={iframeTitle} initialHeight={initialHeight} />
        ) : plan.kind === 'page' ? (
          /* "Runs directly on the page" switched on, and the code is from a known
             or approved service: editor-pasted code with the same trust as the site. */
          <div
            class:list={['w-full', minHeightClass]}
            data-custom-code-on-page
            set:html={embedCode}
          />
        ) : null}
      </div>
    </div>
  </section>
)}
