---
// Foundation, edit with care
// Service area section: heading + description left, optional travel fee table right.
// CONTENT type — receives surface assignment from SectionRenderer.
// travelFees are resolved from businessInfo at query time when showTravelFees is true.
import SectionHeading from '@/components/SectionHeading.astro';

interface Props {
  eyebrow?: string;
  headline?: string;
  description?: string;
  travelFees?: { distanceLabel: string; fee: string }[];
  showTravelFees?: boolean;
  surface?: 'background' | 'muted' | null;
  headingId?: string;
}

const {
  eyebrow = 'Service Area.',
  headline,
  description,
  travelFees = [],
  showTravelFees = true,
  surface = 'background',
  headingId = 'service-area-section-heading',
} = Astro.props as Props;

const show = !!headline || (showTravelFees && travelFees.length > 0);
const bg = surface === 'muted' ? 'bg-muted' : 'bg-background';
const fees = showTravelFees ? travelFees : [];
---

{
  show && (
    <section id="service-area" class={`${bg} scroll-mt-24`} aria-labelledby={headingId}>
      <div class="mx-auto grid max-w-content grid-cols-1 items-start gap-l px-m py-section-lg md:grid-cols-2 md:gap-section-md">
        <div>
          <SectionHeading
            eyebrow={eyebrow}
            headline={headline ?? 'Where We Work.'}
            headingId={headingId}
          />
          {description && (
            <p class="mt-m text-lg leading-relaxed text-foreground/85">{description}</p>
          )}
        </div>

        {fees.length > 0 && (
          <div class="rounded-md bg-muted p-l">
            <p class="mb-m text-xs tracking-widest text-foreground/80 uppercase">
              Travel fee tiers
            </p>
            <dl class="divide-y divide-border-soft">
              {fees.map((tier) => (
                <div class="flex items-baseline justify-between gap-m py-s">
                  <dt class="text-foreground/85">{tier.distanceLabel}</dt>
                  <dd class="font-mono text-sm font-semibold whitespace-nowrap text-link">
                    {tier.fee}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </div>
    </section>
  )
}
